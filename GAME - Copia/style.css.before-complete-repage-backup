.commerce-form { gap: 0; }
.commerce-fields,
.input-row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); }
.commerce-field { display: grid; gap: var(--space-2); }
.commerce-field input { width: 100%; }
.input-group { display: grid; gap: var(--space-2); margin-bottom: var(--space-4); }
.input-group label,
.checkout-form label { color: var(--text); font-size: .8rem; font-weight: 750; }
.checkout-form textarea { min-height: 88px; resize: vertical; }
.payment-options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3); }
.payment-option { min-height: 52px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: #fff; }
.payment-option:has(input:checked) { border-color: var(--primary); background: #fff7ed; box-shadow: 0 0 0 3px rgba(249,115,22,.1); }

/* Store and product cards */
.store-card,
.product-item,
.admin-order-card,
.admin-info-card,
.sales-metrics,
.commerce-products-section { min-width: 0; }
.store-name,
.product-info h3,
.admin-order-customer { overflow-wrap: anywhere; }
.store-category,
.product-info p { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.product-item { align-items: flex-start; }
.product-info { min-width: 0; }
.product-info p { min-height: 2.3em; }
.product-footer { align-items: center; }
.product-footer strong { color: var(--primary-dark); font-size: 1rem; }
.add-button { min-width: 82px; min-height: 42px; }
.store-open-state,
.store-status,
.status-badge,
.admin-status-badge { border-radius: 999px; font-weight: 750; }

/* Admin and general dashboard hierarchy */
.admin-panel { z-index: 50; }
.admin-sheet { width: min(100%, 1180px); max-height: min(94vh, 900px); border-radius: 24px 24px 0 0; }
.admin-header,
.admin-topbar,
.admin-tabs { gap: var(--space-3); }
.admin-navigation-button,
.admin-tab { min-height: 44px; border-radius: 10px; font-weight: 750; }
.admin-main { min-width: 0; }
.admin-info-card,
.admin-order-card { background: #fff; }
.sales-metrics { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-3); }
.sales-metrics > * { min-width: 0; }
.product-toolbar { display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap; }
.product-toolbar input,
.product-toolbar select { flex: 1 1 220px; }
.product-toolbar button { flex: 0 0 auto; width: auto; }

/* Visible system states */
button:active:not(:disabled) { transform: translateY(1px); }
.store-button:disabled,
.add-button:disabled,
.auth-primary-button:disabled,
.confirm-order-button:disabled { box-shadow: none; opacity: .58; }
.loading,
[aria-busy="true"] { cursor: progress; }
.empty-state::before,
.admin-empty-state::before { content: ""; display: block; width: 36px; height: 4px; margin: 0 auto 12px; border-radius: 99px; background: var(--secondary-light); }

/* Better modal and fixed-action behavior */
.admin-details-modal { padding: var(--space-4); }
.admin-details-dialog,
.cancel-order-dialog { max-width: 620px; border: 1px solid rgba(249,115,22,.14); }
.cart-summary { border-top: 1px solid #f3f4f6; }
.finish-order-button,
.confirm-order-button { min-height: 48px; }
.mode-switcher { right: max(16px, calc((100vw - 1180px) / 2)); bottom: max(84px, env(safe-area-inset-bottom)); }

@media (min-width: 1100px) {
  .support-carousel { max-height: 240px; }
  .support-carousel > .store-card,
  .support-carousel > .promo-slide { max-height: 240px; }
}

@media (max-width: 820px) {
  .sales-metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .admin-sheet { max-height: 96vh; }
  .commerce-fields { grid-template-columns: 1fr; gap: 0; }
  .content { gap: var(--space-5); }
}

@media (max-width: 560px) {
  .commerce-fields,
  .input-row,
  .payment-options { grid-template-columns: 1fr; gap: 0; }
  .sales-metrics { grid-template-columns: 1fr 1fr; }
  .product-toolbar { align-items: stretch; }
  .product-toolbar input,
  .product-toolbar select,
  .product-toolbar button { flex-basis: 100%; width: 100%; }
  .admin-details-modal { padding: 10px; }
  .panel-sheet { border-radius: 20px 20px 0 0; }
  .menu-products { padding-left: 14px; padding-right: 14px; }
  .product-item img { width: 78px; height: 78px; }
  .mode-switcher { right: 14px; width: min(180px, calc(100vw - 28px)); }
}

@media (min-width: 561px) {
  .auth-view > .auth-back-button:not([data-forgot-password]):not([data-use-another-account]) { width: auto; min-width: 112px; }
}
