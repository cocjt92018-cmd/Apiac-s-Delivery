.admin-panel {
  align-items: stretch;
  background: rgba(47, 52, 55, 0.52);
}
.admin-sheet {
  width: min(100%, 980px);
  height: 100%;
  max-height: none;
  margin-left: auto;
  flex-direction: row;
  border-radius: 0;
  animation: admin-panel-enter 0.22s ease-out;
}
@keyframes admin-panel-enter {
  from { transform: translateX(24px); opacity: 0.7; }
  to { transform: translateX(0); opacity: 1; }
}
.admin-sidebar {
  width: 230px;
  flex: 0 0 230px;
  background: #fffaf7;
  border-right: 1px solid var(--border);
}
.admin-sidebar-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  padding: 20px 16px;
  border-bottom: 1px solid var(--border);
}
.admin-sidebar-header strong {
  display: block;
  margin-top: 4px;
  color: var(--text);
  font-size: 0.9rem;
}
.admin-navigation {
  display: grid;
  gap: 4px;
  padding: 14px 10px;
}
.admin-navigation-button {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  min-height: 44px;
  border: 1px solid transparent;
  border-radius: 10px;
  padding: 10px 12px;
  background: transparent;
  color: var(--text-secondary);
  text-align: left;
  font-size: 0.84rem;
  font-weight: 700;
  cursor: pointer;
}
.admin-navigation-button:hover,
.admin-navigation-button:focus-visible {
  background: #fdf0ea;
  color: var(--primary-dark);
  outline: none;
}
.admin-navigation-button.active {
  border-color: rgba(231, 111, 81, 0.24);
  background: #fdf0ea;
  color: var(--primary-dark);
}
.admin-navigation-exit {
  margin-top: 18px;
  border-top: 1px solid var(--border);
  border-radius: 0 0 10px 10px;
  padding-top: 18px;
}
.admin-nav-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 22px;
  color: var(--primary);
  font-size: 1.1rem;
  line-height: 1;
}
.admin-nav-icon svg {
  width: 18px;
  height: 18px;
  fill: none;
  stroke: currentColor;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: 1.8;
}
.admin-main {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  background: var(--background);
}
.admin-main > .admin-header {
  position: sticky;
  top: 0;
  z-index: 1;
  min-height: 76px;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 2px 12px rgba(92, 65, 54, 0.05);
}
.admin-header-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}
.admin-page {
  flex: 1;
  min-width: 0;
  overflow-y: auto;
}
.admin-page-intro {
  padding: 24px 20px 8px;
}
.admin-page-intro h3 {
  margin: 4px 0 6px;
  font-size: 1.25rem;
}
.admin-page-intro p:last-child {
  margin: 0;
  color: var(--text-secondary);
  font-size: 0.84rem;
}
.admin-info-card {
  display: grid;
  gap: 18px;
  margin: 16px 20px;
  padding: 20px;
  border: 1px solid var(--border);
  border-radius: 16px;
  background: var(--surface);
  box-shadow: var(--shadow-soft);
}
.admin-info-card > div {
  display: grid;
  gap: 5px;
}
.admin-card-label {
  color: var(--text-secondary);
  font-size: 0.74rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
.admin-store-status-row {
  display: flex !important;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding-top: 14px;
  border-top: 1px solid var(--border);
}
.admin-store-status-row strong {
  color: var(--success);
  font-size: 0.9rem;
}
.admin-store-status-row strong.closed {
  color: var(--danger);
}
.switch {
  position: relative;
  display: inline-flex;
  width: 48px;
  height: 28px;
  flex: 0 0 auto;
}
.switch input {
  position: absolute;
  width: 1px;
  height: 1px;
  opacity: 0;
}
.switch-slider {
  position: absolute;
  inset: 0;
  border-radius: 999px;
  background: #d8d0cb;
  cursor: pointer;
  transition: background 0.2s ease;
}
.switch-slider::before {
  position: absolute;
  width: 22px;
  height: 22px;
  top: 3px;
  left: 3px;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 2px 5px rgba(47, 52, 55, 0.16);
  content: '';
  transition: transform 0.2s ease;
}
.switch input:checked + .switch-slider {
  background: var(--success);
}
.switch input:checked + .switch-slider::before {
  transform: translateX(20px);
}
.switch input:focus-visible + .switch-slider {
  outline: 3px solid rgba(231, 111, 81, 0.22);
  outline-offset: 2px;
}
.switch-small {
  width: 42px;
  height: 24px;
}
.switch-small .switch-slider::before {
  width: 18px;
  height: 18px;
  top: 3px;
  left: 3px;
}
.switch-small input:checked + .switch-slider::before {
  transform: translateX(18px);
}
.admin-product-availability-list {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
  padding: 16px 20px 24px;
  max-height: none;
}
.admin-product-store-group {
  gap: 10px;
  padding: 14px;
  border: 1px solid var(--border);
  border-radius: 14px;
  background: var(--surface);
  box-shadow: var(--shadow-soft);
}
.admin-product-store-group > strong {
  font-size: 0.86rem;
}
.admin-product-toggle-list {
  gap: 0;
}
.admin-product-toggle {
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 10px 0;
  border-top: 1px solid #f1e9e4;
}
.admin-product-info {
  display: grid;
  min-width: 0;
  gap: 3px;
}
.admin-product-info strong,
.admin-product-info small {
  overflow-wrap: anywhere;
}
.admin-product-info strong {
  color: var(--text);
  font-size: 0.8rem;
}
.admin-product-info small {
  color: var(--text-secondary);
  font-size: 0.7rem;
}
.admin-settings-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.admin-settings-card span:not(.settings-status) {
  color: var(--text-secondary);
  font-size: 0.76rem;
}
.settings-status {
  color: var(--success);
  font-size: 0.76rem;
  font-weight: 700;
}
@media (max-width: 700px) {
  .admin-sheet {
    width: 100%;
  }
  .admin-sidebar {
    width: min(72vw, 250px);
    flex-basis: min(72vw, 250px);
  }
  .admin-product-availability-list {
    grid-template-columns: 1fr;
  }
}
@media (max-width: 520px) {
  .admin-sidebar {
    width: 188px;
    flex-basis: 188px;
  }
  .admin-sidebar-header {
    padding: 16px 10px;
  }
  .admin-navigation {
    padding: 12px 6px;
  }
  .admin-navigation-button {
    padding-right: 6px;
    padding-left: 8px;
    font-size: 0.76rem;
  }
  .admin-page-intro,
  .admin-info-card {
    padding-right: 14px;
    padding-left: 14px;
  }
  .admin-info-card {
    margin-right: 14px;
    margin-left: 14px;
  }
  .admin-product-availability-list {
    padding-right: 14px;
    padding-left: 14px;
  }
}
/* Commerce drawer: the panel stays open while its navigation slides in. */
.admin-sheet {
  position: relative;
  display: block;
  width: min(100%, 980px);
  height: 100%;
  max-height: none;
  margin-left: auto;
  overflow: hidden;
  background: var(--background);
}
.admin-sidebar {
  position: absolute;
  inset: 0 auto 0 0;
  z-index: 4;
  width: min(84vw, 280px);
  transform: translateX(-102%);
  transition: transform 0.22s ease;
  box-shadow: 10px 0 24px rgba(47, 52, 55, 0.12);
}
.admin-sidebar.open {
  transform: translateX(0);
}
.admin-menu-overlay {
  position: absolute;
  inset: 0;
  z-index: 3;
  background: rgba(47, 52, 55, 0.48);
  opacity: 1;
  transition: opacity 0.22s ease;
}
.admin-menu-overlay.hidden {
  display: none;
}
.admin-main {
  width: 100%;
  height: 100%;
}
.admin-menu-trigger {
  flex-shrink: 0;
}
/* Authentication and commerce forms */
.product-toolbar { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
.product-toolbar :is(input, select) { width: 100%; min-width: 0; min-height: 44px; padding: 10px; border: 1px solid var(--border); border-radius: 10px; background: var(--surface); color: var(--text); font: inherit; }
.commerce-products-section { padding-top: 16px; }
#commerceRegisterForm { max-height: 75dvh; overflow-y: auto; padding: 4px; }
@media (max-width: 600px) { .product-toolbar { grid-template-columns: 1fr; } }
#adminProductAvailabilityList { grid-template-columns: minmax(0, 1fr); }
.commerce-registration { margin: 0; }
.commerce-registration > div { min-width: 0; padding-bottom: 12px; border-bottom: 1px solid var(--border); }
.commerce-registration dt { color: var(--text-secondary); font-size: 1rem; }
.commerce-registration dd { margin: 4px 0 0; font-weight: 600; overflow-wrap: anywhere; }
.admin-refresh-icon { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; flex: 0 0 44px; margin-left: auto; }
.admin-refresh-icon svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
#adminOrdersPage > .admin-toolbar { align-items: center; }
.sales-metrics { display: grid !important; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
.sales-metrics > div { padding: 16px; background: var(--background); border-radius: 12px; display: grid; gap: 6px; }
.sales-metrics strong { font-size: 1.4rem; color: var(--primary-dark); }
.sales-chart { display: grid; gap: 16px; }
.sales-chart-row { display: grid; grid-template-columns: 100px minmax(0, 1fr) auto; align-items: center; gap: 12px; }
.sales-chart-track { background: var(--background); border-radius: 8px; overflow: hidden; }
.sales-chart-track > div { height: 24px; background: var(--primary-dark); border-radius: 8px; }
@media (max-width: 520px) {
  .sales-chart-row { grid-template-columns: 1fr auto; }
  .sales-chart-track { grid-column: 1 / -1; grid-row: 2; }
  .sales-metrics { grid-template-columns: minmax(0, 1fr); }
}
.client-orders-page { max-width: 760px; margin: 0 auto; padding: 24px 16px; font-size: 16px; line-height: 1.5; }
.client-orders-header { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; }
.client-orders-header button, .client-order-card summary { min-height: 44px; padding: 12px; cursor: pointer; }
.client-order-card { margin-top: 16px; padding: 20px; border: 1px solid var(--border); border-radius: 16px; background: var(--surface); box-shadow: var(--shadow-soft); overflow-wrap: anywhere; }
.client-orders-page :focus-visible { outline: 3px solid var(--primary-dark); outline-offset: 3px; }
.auth-screen { min-height: 100dvh; }
.auth-card { padding: clamp(20px, 5vw, 36px); }
.auth-screen :is(p, label, input, button),
.admin-panel :is(p, label, input, select, button, strong, small, .admin-navigation-button) { font-size: 1rem; }
.auth-screen, .admin-panel { line-height: 1.5; }
.auth-screen button, .admin-panel button { min-height: 44px; }
.auth-screen :focus-visible, .admin-panel :focus-visible { outline: 3px solid var(--primary-dark); outline-offset: 3px; }
.admin-navigation-button.active { background: var(--primary-dark); color: var(--surface); border-color: var(--primary-dark); }
.admin-navigation-button.active .admin-nav-icon { color: inherit; }
.admin-sidebar { overflow-y: auto; visibility: hidden; transition: transform .22s ease, visibility .22s; }
.admin-sidebar.open { visibility: visible; }
.admin-page { min-height: 0; overflow-wrap: anywhere; }
.admin-header > div { min-width: 0; }
.admin-header { flex-wrap: wrap; }
.commerce-form { gap: 20px; }
.commerce-fields { display: grid !important; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; min-width: 0; border: 0; padding: 0; margin: 0; }
.commerce-field { display: grid; gap: 6px; min-width: 0; font-weight: 600; }
.commerce-field :is(input, select) { width: 100%; min-width: 0; min-height: 48px; border: 1px solid var(--border); border-radius: 10px; background: var(--surface); color: var(--text); padding: 10px 12px; font: inherit; font-weight: 400; }
.commerce-toggle { display: flex; justify-content: space-between; align-items: center; gap: 16px; min-height: 48px; }
.commerce-toggle strong { display: block; font-weight: 400; color: var(--text-secondary); }
.commerce-form > button { width: auto; justify-self: start; min-height: 48px; }
.form-message { margin: 0; color: #326340; overflow-wrap: anywhere; }
.form-message.error, .auth-error { color: #a02c2c; }
.form-message:empty { display: none; }
.commerce-fields.hidden { display: none !important; }
.admin-order-card { background: var(--surface); box-shadow: var(--shadow-soft); }
.admin-tabs { display: flex; flex-wrap: wrap; gap: 8px; }
.admin-tab { flex: 1; }
.admin-tab.active { background: var(--primary-dark); color: var(--surface); }
@media (max-width: 520px) {
  .commerce-fields { grid-template-columns: minmax(0, 1fr); }
  .commerce-form > button { width: 100%; }
  .admin-main > .admin-header { padding: 12px 14px; gap: 10px; }
  .admin-header-actions { margin-left: auto; }
  .admin-order-meta { gap: 10px; }
}
@media (prefers-reduced-motion: reduce) {
  .admin-sheet { animation: none; }
  .admin-sidebar, .switch-slider, .switch-slider::before { transition: none; }
}
/* Saved app-wide dark appearance. */
:root.dark-mode {
  color-scheme: dark;
  --background: #16191d;
  --surface: #22272d;
  --text: #f1f3f5;
  --text-secondary: #b7bec7;
  --border: #414850;
  --primary-dark: #f4a58f;
  --success: #9bd3a9;
  --danger: #ffaaa5;
  --shadow-soft: 0 8px 22px rgba(0,0,0,.2);
}
.dark-mode :is(.panel-sheet,.menu-header,.menu-products,.cart-header,.cart-items,.cart-summary,.admin-header,.admin-toolbar,.admin-sidebar,.admin-order-details,.admin-details-dialog,.cancel-order-dialog,.checkout-sheet,.payment-option,.currency-input,.checkout-summary-box,.success-summary,.empty-state,.admin-refresh-button,.admin-order-filters,.admin-operation-controls,.admin-product-controls,.admin-deliverer-controls) { background: var(--surface); color: var(--text); }
.dark-mode :is(input,select,textarea) { background-color: var(--surface); color: var(--text); border-color: var(--border); }
.dark-mode :is(.category-item,.auth-secondary-button,.checkout-back-button,.close-menu,.close-cart,.qty-button,.admin-secondary-button,.admin-details-button,.admin-tab,.admin-navigation-button:hover,.payment-option:has(input:checked)) { background: #353034; color: var(--text); }
.dark-mode :is(.admin-navigation-button.active,.admin-tab.active,.category-item.active,.auth-primary-button,.confirm-order-button,.store-button,.add-button,.cart-button) { background: #a9432d; color: #fff; }
.dark-mode :is(.form-message,.settings-status,.success-icon) { color: var(--success); }
.dark-mode :is(.form-message.error,.auth-error,.cancel-reason-error,.cash-change-message.error) { color: var(--danger); }
.dark-mode .admin-danger-button { background: #9e3030; color: #fff; }
.dark-mode .admin-new-badge { background: #452a2b; }
.dark-mode .admin-late-badge { background: #493920; color: #f6ce8b; }
.dark-mode .success-icon { background: #253c2e; }
.general-admin-panel { width: min(100%, 980px); margin: 0 auto; padding: 20px 16px; }
.general-admin-panel .admin-tabs { padding: 12px 0; }
.general-admin-panel .admin-info-card { margin: 16px 0; }
.general-admin-panel .commerce-form { display: grid; gap: 16px; }
.general-admin-panel .auth-primary-button { min-height: 44px; }
.general-admin-panel .commerce-registration dd { white-space: pre-wrap; }
.mode-switcher { position: fixed; z-index: 70; right: max(16px, calc((100vw - 1180px) / 2)); bottom: 84px; width: 156px; }
.mode-switcher-button { width: 100%; min-height: 44px; border: 1px solid var(--border); border-radius: 10px; background: var(--primary); color: #fff; font-weight: 700; cursor: pointer; box-shadow: var(--shadow-soft); }
.mode-switcher-button:hover, .mode-switcher-button:focus-visible { background: var(--primary-dark); }
.mode-switcher-options { display: none; gap: 4px; margin-bottom: 8px; padding: 6px; border: 1px solid var(--border); border-radius: 10px; background: var(--surface); box-shadow: var(--shadow-soft); }
.mode-switcher.open .mode-switcher-options { display: grid; }
.mode-switcher-options button { min-height: 40px; border: 0; border-radius: 7px; background: transparent; color: var(--text); text-align: left; padding: 8px 10px; font-weight: 600; cursor: pointer; }
.mode-switcher-options button:hover, .mode-switcher-options button:focus-visible { background: var(--secondary-light); }
.mode-switcher-options button.active { background: var(--primary); color: #fff; }
.mode-switcher-options button:disabled { cursor: not-allowed; opacity: .45; }
.category-item { transition: background-color .2s ease, color .2s ease, border-color .2s ease; }
.auth-secondary-button,
.category-item:not(.active),
.admin-button,
.admin-refresh-button { background: var(--surface); color: var(--primary); }
.location-button,
.results-count,
.store-badge { background: var(--secondary-light); color: var(--primary); }
.store-rating { color: var(--secondary); }
.close-menu,
.close-cart,
.qty-button { background: var(--background); color: var(--primary); }
.menu-store-rating { background: var(--accent); color: var(--primary); }
@media (prefers-reduced-motion: reduce) {
  .store-card, .category-item { transition: none; }
  .category-list { scroll-behavior: auto; }
  .store-card:hover { transform: none; }
}

/* Authentication visual refresh: intentionally scoped to the auth screen. */
#authScreen.auth-screen {
  min-height: 100dvh;
  padding: clamp(16px, 3vw, 36px);
  background: linear-gradient(135deg, #f7f2e7 0%, #eef3ed 100%);
}
#authScreen .auth-layout {
  display: grid;
  grid-template-columns: minmax(280px, .95fr) minmax(360px, 420px);
  width: min(100%, 960px);
  min-height: min(690px, calc(100dvh - 48px));
  overflow: hidden;
  border: 1px solid rgba(18, 58, 104, .12);
  border-radius: 28px;
  background: var(--surface);
  box-shadow: 0 24px 70px rgba(18, 58, 104, .16);
}
#authScreen .auth-showcase {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 100%;
  padding: clamp(32px, 6vw, 68px);
  color: #fff;
  background: linear-gradient(145deg, #0d2d52 0%, #123a68 58%, #1e5a7e 100%);
}
#authScreen .auth-showcase-kicker {
  display: inline-block;
  margin-bottom: 18px;
  font-size: .72rem;
  font-weight: 800;
  letter-spacing: .14em;
  color: #fad7aa;
}
#authScreen .auth-showcase h1 {
  max-width: 420px;
  margin: 0;
  font-size: clamp(2.1rem, 4vw, 3.35rem);
  line-height: 1.05;
  letter-spacing: -.045em;
}
#authScreen .auth-showcase p {
  max-width: 360px;
  margin: 22px 0 0;
  color: rgba(255, 255, 255, .78);
  font-size: 1rem;
  line-height: 1.6;
}
#authScreen .auth-showcase-note {
  padding-top: 22px;
  border-top: 1px solid rgba(255, 255, 255, .24);
  color: #fad7aa;
  font-size: .85rem;
  font-weight: 700;
}
#authScreen .auth-panel {
  width: 100%;
  min-height: 100%;
  max-height: calc(100dvh - 48px);
  padding: clamp(26px, 5vw, 48px);
  overflow-y: auto;
  border: 0;
  border-radius: 0;
  box-shadow: none;
  background: var(--surface);
}
#authScreen .auth-brand { margin-bottom: 34px; }
#authScreen .auth-brand .brand-mark {
  display: inline-flex;
  width: 46px;
  height: 46px;
  overflow: hidden;
  border-radius: 14px;
  box-shadow: 0 8px 18px rgba(18, 58, 104, .15);
}
#authScreen .auth-brand .brand-logo { width: 100%; height: 100%; object-fit: cover; }
#authScreen .auth-brand .brand-name { margin: 0; font-size: 1rem; font-weight: 800; }
#authScreen .auth-brand small { color: var(--text-secondary); }
#authScreen .auth-view h1 { font-size: 1.7rem; letter-spacing: -.025em; }
#authScreen .auth-subtitle { margin-bottom: 26px; font-size: .95rem; }
#authScreen .auth-actions { gap: 12px; }
#authScreen .auth-primary-button,
#authScreen .auth-secondary-button {
  min-height: 50px;
  transition: transform .18s ease, box-shadow .18s ease, background-color .18s ease;
}
#authScreen .auth-primary-button {
  border-color: var(--primary);
  background: var(--primary);
  color: #fff;
  box-shadow: 0 9px 18px rgba(18, 58, 104, .18);
}
#authScreen .auth-primary-button:hover,
#authScreen .auth-primary-button:focus-visible { background: var(--primary-dark); color: #fff; transform: translateY(-1px); }
#authScreen .auth-secondary-button { border-color: var(--border); background: #fff; color: var(--primary); }
#authScreen .auth-secondary-button:hover,
#authScreen .auth-secondary-button:focus-visible { border-color: var(--primary); background: #f5f8fb; }
#authScreen .auth-field { margin-top: 16px; font-size: .82rem; }
#authScreen .auth-view input { min-height: 50px; padding: 13px 14px; border-radius: 12px; }
#authScreen .input-wrap { position: relative; }
#authScreen .input-wrap input { padding-right: 82px; }
#authScreen .password-toggle {
  position: absolute;
  top: 50%;
  right: 8px;
  min-height: 34px;
  padding: 4px 9px;
  border: 0;
  border-radius: 8px;
  transform: translateY(-50%);
  background: transparent;
  color: var(--primary);
  font-size: .78rem;
  font-weight: 800;
  cursor: pointer;
}
#authScreen .password-toggle:hover,
#authScreen .password-toggle:focus-visible { background: #edf3f8; }
