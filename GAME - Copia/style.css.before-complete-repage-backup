/* Apiacás Delivery — visual system refresh */
:root {
  --primary: #f97316;
  --primary-dark: #c2410c;
  --primary-light: #fb923c;
  --secondary: #fff7ed;
  --secondary-light: #ffedd5;
  --accent: #f59e0b;
  --success: #16a34a;
  --danger: #dc2626;
  --info: #2563eb;
  --delivery: #2563eb;
  --text: #1f2937;
  --text-secondary: #6b7280;
  --background: #fff7ed;
  --surface: #ffffff;
  --border: #e5e7eb;
  --bg-color: var(--background);
  --card-color: var(--surface);
  --primary-color: var(--primary);
  --accent-color: var(--accent);
  --text-color: var(--text);
  --muted-color: var(--text-secondary);
  --border-color: var(--border);
  --shadow-soft: 0 10px 30px rgba(124, 45, 18, .08);
  --shadow-card: 0 4px 18px rgba(31, 41, 55, .07);
  --radius-sm: 10px;
  --radius-md: 16px;
  --radius-lg: 22px;
  --transition: 180ms ease;
}

html { scroll-behavior: smooth; }
body { font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background: var(--background); color: var(--text); }
button, input, textarea, select { font-family: inherit; }
button { transition: transform var(--transition), background var(--transition), border-color var(--transition), box-shadow var(--transition), color var(--transition); }
button:focus-visible, input:focus-visible, textarea:focus-visible, select:focus-visible, [tabindex]:focus-visible { outline: 3px solid rgba(249, 115, 22, .3); outline-offset: 2px; }
.hidden { display: none !important; }

/* Authentication */
.auth-screen { min-height: 100svh; padding: 28px 20px; background: radial-gradient(circle at 15% 10%, #fed7aa 0, transparent 32%), var(--background); }
.auth-layout { display: grid; grid-template-columns: minmax(280px, 1fr) minmax(360px, 520px); width: min(1120px, 100%); min-height: min(720px, calc(100svh - 56px)); overflow: hidden; border: 1px solid rgba(194, 65, 12, .12); border-radius: 28px; background: var(--surface); box-shadow: 0 24px 70px rgba(124, 45, 18, .14); }
.auth-showcase { display: flex; flex-direction: column; justify-content: space-between; padding: clamp(32px, 6vw, 72px); color: white; background: linear-gradient(145deg, #ea580c, #f97316 55%, #fb923c); }
.auth-showcase-kicker { display: inline-block; margin-bottom: 24px; font-size: .74rem; font-weight: 800; letter-spacing: .16em; }
