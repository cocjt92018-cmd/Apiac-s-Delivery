/* Client shell */
.app-shell { width: min(100%, 1180px); min-height: 100vh; padding: 24px clamp(18px, 4vw, 54px) 54px; background: transparent; }
.topbar { position: sticky; top: 0; z-index: 10; margin: -24px calc(clamp(18px, 4vw, 54px) * -1) 28px; padding: 16px clamp(18px, 4vw, 54px); border-bottom: 1px solid rgba(229,231,235,.86); background: rgba(255,247,237,.9); backdrop-filter: blur(14px); }
