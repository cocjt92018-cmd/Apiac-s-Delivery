:root {
  --primary: #123A68;
  --primary-dark: #0D2D52;
  --primary-light: #345D88;
  --secondary: #F28C28;
  --secondary-light: #FAD7AA;
  --accent: #F2C94C;
  --success: #6FAE3A;
  --danger: #B42318;
  --info: #4778A8;
  --delivery: #4778A8;
  --text: #123A68;
  --text-secondary: #5F6F82;
  --background: #F7F2E7;
  --surface: #FFFFFF;
  --border: #D8CFBF;
  --bg-color: var(--background);
  --card-color: var(--surface);
  --primary-color: var(--primary);
  --accent-color: var(--accent);
  --text-color: var(--text);
  --muted-color: var(--text-secondary);
  --border-color: var(--border);
  --shadow-soft: 0 8px 22px rgba(18, 58, 104, 0.1);
}
* {
  box-sizing: border-box;
}
html, body {
  max-width: 100%;
  overflow-x: hidden;
}
body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: var(--background);
  color: var(--text-color);
}
.auth-screen {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 100vh;
  padding: 24px 16px;
  background: var(--background);
}
.auth-card {
  width: min(100%, 420px);
  padding: 28px 24px;
  border: 1px solid var(--border);
  border-radius: 22px;
  background: var(--surface);
  box-shadow: var(--shadow-soft);
}
.auth-brand {
  margin-bottom: 34px;
}
.auth-view h1 {
  margin: 0;
  font-size: 1.55rem;
  line-height: 1.2;
}
.auth-subtitle {
  margin: 10px 0 24px;
  color: var(--text-secondary);
  font-size: 0.9rem;
  line-height: 1.45;
}
.auth-actions {
  display: grid;
  gap: 10px;
}
.auth-primary-button,
.auth-secondary-button,
.auth-back-button {
  width: 100%;
  min-height: 46px;
  border-radius: 12px;
  padding: 12px 16px;
  font-weight: 700;
  cursor: pointer;
}
.auth-primary-button {
  border: 1px solid var(--primary);
  overflow: hidden;
  background: #fff;
}
.auth-primary-button:hover,
.auth-primary-button:focus-visible {
  border-color: var(--primary-dark);
  background: var(--primary-dark);
}
.auth-secondary-button {
  border: 1px solid var(--secondary);
  background: #fff8f2;
  color: var(--primary-dark);
}
.auth-secondary-button:hover,
.auth-secondary-button:focus-visible {
  background: var(--secondary-light);
}
.google-login-button {
  width: 100%;
  min-height: 46px;
  margin-top: 10px;
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 12px 16px;
  background: #fff;
  color: var(--text);
  font-weight: 700;
  cursor: pointer;
}
.google-login-button:hover,
.google-login-button:focus-visible { border-color: var(--primary); background: #f5f8fb; }
.auth-back-button {
  margin-top: 8px;
  border: 0;
  background: transparent;
  color: var(--text-secondary);
}
.auth-view > .auth-secondary-button { margin-top: 10px; }
.auth-back-button:hover,
.auth-back-button:focus-visible {
  color: var(--primary-dark);
  outline: none;
}
.auth-field {
  display: block;
  margin: 14px 0 6px;
  color: var(--text);
  font-size: 0.8rem;
  font-weight: 700;
}
.auth-view input {
  width: 100%;
  border: 1px solid var(--border);
  border-radius: 11px;
  padding: 12px 13px;
  background: #fff;
  color: var(--text);
  outline: none;
}
.auth-view input:focus {
  border-color: var(--primary);
  outline: 3px solid rgba(231, 111, 81, 0.14);
}
.auth-error {
  min-height: 18px;
  margin: 8px 0 4px;
  color: var(--danger);
  font-size: 0.78rem;
}
button,
input {
  font: inherit;
}
.app-shell {
  width: min(100%, 480px);
  max-width: 100%;
  min-height: 100vh;
  margin: 0 auto;
  background: var(--bg-color);
  padding: 20px 16px 32px;
}
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
}
.topbar-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}
.brand {
  display: flex;
  align-items: center;
  gap: 10px;
}
.brand-mark {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 42px;
  height: 42px;
  border-radius: 14px;
  background: var(--primary);
  color: #fff;
  font-weight: 700;
  font-size: 1.2rem;
}
.brand-logo {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.brand-name {
  margin: 0;
  font-size: 1rem;
  font-weight: 700;
}
.brand small {
  color: var(--muted-color);
}
.location-button {
  border: none;
  background: var(--secondary-light);
  color: var(--primary-dark);
  padding: 10px 12px;
  border-radius: 999px;
  font-size: 0.8rem;
  font-weight: 600;
}
.admin-button,
.admin-refresh-button {
  border: 1px solid var(--border-color);
  background: #fff;
  color: var(--primary-dark);
  border-radius: 10px;
  padding: 9px 10px;
  font-size: 0.76rem;
  font-weight: 700;
  cursor: pointer;
}
.admin-button:hover,
.admin-refresh-button:hover {
  border-color: var(--primary-color);
  background: #FDF0EA;
}
.search-panel,
.categories-panel,
.stores-panel {
  margin-bottom: 22px;
}
.search-label,
.section-header h2 {
  display: block;
  margin-bottom: 10px;
  font-size: 1rem;
  font-weight: 700;
}
.search-box {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  background: var(--card-color);
  border: 1px solid var(--border-color);
  border-radius: 16px;
  padding: 0 14px;
  box-shadow: var(--shadow-soft);
}
.search-icon {
  font-size: 1.2rem;
}
.search-box input {
  width: 100%;
  border: none;
  background: transparent;
  padding: 16px 0;
  font-size: 0.96rem;
  outline: none;
}
.category-list {
  display: flex;
  gap: 10px;
  overflow-x: auto;
  scroll-behavior: smooth;
  padding-bottom: 6px;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
  white-space: nowrap;
}
.category-list::-webkit-scrollbar {
  display: none;
}
.category-item {
  flex: 0 0 auto;
  max-width: 100%;
  border: 1px solid var(--border-color);
  background: #FCF1EB;
  color: var(--text-color);
  border-radius: 999px;
  padding: 10px 14px;
  white-space: nowrap;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
}
.category-item.active {
  background: var(--primary-color);
  color: #fff;
  border-color: var(--primary-color);
}
.section-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.results-count {
  background: var(--secondary-light);
  color: var(--primary-dark);
  border-radius: 999px;
  padding: 6px 10px;
  font-size: 0.8rem;
  font-weight: 700;
}
.store-list {
  display: grid;
  gap: 14px;
}
.store-card {
  background: var(--card-color);
  border: 1px solid var(--border-color);
  border-radius: 20px;
  padding: 14px;
  box-shadow: var(--shadow-soft);
  transition: transform .25s ease, box-shadow .25s ease;
}
.store-card:hover { transform: translateY(-2px); box-shadow: 0 12px 26px rgba(18, 58, 104, 0.14); }
.support-card {
  display: block;
  padding: 0;
  overflow: hidden;
}
.support-carousel {
  display: flex;
  gap: 14px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
}
.support-carousel::-webkit-scrollbar { display: none; }
.support-carousel > .store-card {
  flex: 0 0 100%;
  min-width: 100%;
  width: 100%;
  box-sizing: border-box;
  aspect-ratio: 1112 / 626;
  padding: 0;
  overflow: hidden;
  border: 1px solid var(--border-color);
  border-radius: 20px;
  background: var(--card-color);
  scroll-snap-align: start;
  transform: translateZ(0);
  transition: transform .25s ease, box-shadow .25s ease;
}
.support-card img,
.promotion-card img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.promo-slide {
  flex: 0 0 100%;
  min-width: 100%;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  aspect-ratio: 1112 / 626;
  padding: 0;
  margin: 0;
  overflow: hidden;
  border-radius: 20px;
  scroll-snap-align: start;
  transform: translateZ(0);
  transition: transform .25s ease;
  cursor: pointer;
}
.promo-slide img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  object-position: center;
  border-radius: inherit;
}
.store-header {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 10px;
}
.store-badge {
  width: 52px;
  height: 52px;
  border-radius: 16px;
  background: var(--secondary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.3rem;
  font-weight: 700;
  color: var(--primary-dark);
}
.store-main {
  flex: 1;
}
.store-name {
  margin: 0;
  font-size: 1.05rem;
}
.store-category {
  margin: 4px 0 0;
  color: var(--muted-color);
  font-size: 0.85rem;
}
.store-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
  color: var(--muted-color);
  font-size: 0.82rem;
}
.store-rating {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  color: #A56B32;
  font-weight: 700;
}
.store-button {
  width: 100%;
  border: none;
  border-radius: 12px;
  background: var(--primary-color);
  color: white;
  padding: 12px 14px;
  font-weight: 700;
  cursor: pointer;
}
.store-button:hover {
  background: var(--primary-dark);
}
.empty-state {
  background: #fff;
  border: 1px dashed var(--border-color);
  border-radius: 16px;
  padding: 22px 16px;
  text-align: center;
  color: var(--muted-color);
}
.status-message {
  z-index: 100;
  max-width: calc(100vw - 32px);
  position: fixed;
  left: 50%;
  bottom: 18px;
  transform: translateX(-50%) translateY(20px);
  background: rgba(47, 52, 55, 0.94);
  color: #fff;
  padding: 10px 14px;
  border-radius: 999px;
  font-size: 0.82rem;
  opacity: 0;
  transition: all 0.25s ease;
  pointer-events: none;
}
.status-message.show {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}
.menu-panel,
.cart-panel {
  position: fixed;
  inset: 0;
  background: rgba(17, 24, 39, 0.4);
  display: flex;
  justify-content: center;
  align-items: flex-end;
  z-index: 30;
  padding: 0;
}
.menu-panel.hidden,
.cart-panel.hidden {
  display: none;
}
.panel-sheet {
  width: min(100%, 480px);
  max-height: min(82vh, 760px);
  background: #fff;
  border-radius: 24px 24px 0 0;
  box-shadow: 0 -10px 25px rgba(0, 0, 0, 0.12);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.menu-header {
  width: 100%;
  background: #fff;
  border-radius: 24px 24px 0 0;
  padding: 18px 16px 8px;
  display: flex;
  align-items: flex-start;
  gap: 10px;
  flex-shrink: 0;
}
.close-menu {
  border: none;
  background: #edf5ef;
  color: var(--primary-dark);
  width: 38px;
  height: 38px;
  border-radius: 12px;
  font-size: 1.3rem;
  font-weight: 700;
  cursor: pointer;
}
.menu-title-box {
  flex: 1;
}
.menu-store-category {
  margin: 0 0 4px;
  color: var(--muted-color);
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
.menu-title-box h2 {
  margin: 0;
  font-size: 1.25rem;
}
.menu-store-rating {
  background: #fff5cf;
  color: #8b5b00;
  border-radius: 999px;
  padding: 8px 10px;
  font-weight: 700;
  font-size: 0.8rem;
}
.menu-products {
  width: 100%;
  overflow-y: auto;
  background: #fff;
  padding: 8px 16px 24px;
  flex: 1 1 auto;
  min-height: 0;
  -webkit-overflow-scrolling: touch;
}
.product-item {
  display: flex;
  gap: 12px;
  padding: 12px 0;
  border-bottom: 1px solid var(--border-color);
}
.product-item img {
  width: 86px;
  height: 86px;
  border-radius: 16px;
  object-fit: cover;
  background: #f3f4f6;
}
.product-info {
  flex: 1;
}
.product-info h3 {
  margin: 2px 0 6px;
  font-size: 1rem;
}
.product-info p {
  margin: 0;
  color: var(--muted-color);
  font-size: 0.82rem;
  line-height: 1.4;
}
.product-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-top: 10px;
}
.product-footer strong {
  font-size: 0.95rem;
  color: var(--text-color);
}
.add-button {
  border: none;
  background: var(--primary-color);
  color: #fff;
  border-radius: 10px;
  padding: 9px 10px;
  font-size: 0.75rem;
  font-weight: 700;
  cursor: pointer;
}
.add-button:hover {
  background: var(--primary-dark);
}
.finish-order-button,
.confirm-order-button {
  width: 100%;
  border: none;
  border-radius: 12px;
  background: var(--primary-color);
  color: #fff;
  padding: 14px 16px;
  font-weight: 700;
  cursor: pointer;
}
.finish-order-button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}
.cart-button {
  position: fixed;
  right: 16px;
  bottom: 18px;
  z-index: 20;
  border: none;
  background: var(--primary-color);
  color: #fff;
  border-radius: 999px;
  padding: 12px 16px;
  display: flex;
  align-items: center;
  gap: 10px;
  font-weight: 700;
  box-shadow: 0 12px 25px rgba(30, 142, 90, 0.35);
  cursor: pointer;
}
.cart-button.hidden {
  display: none;
}
.cart-button-text {
  font-size: 0.85rem;
}
#cartTotalPreview:empty {
  display: none;
}
#cartTotalPreview:not(:empty)::before {
  content: "·";
  margin: 0 4px;
}
.cart-count {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 24px;
  height: 24px;
  border-radius: 50%;
  background: #fff;
  color: var(--primary-dark);
  font-size: 0.72rem;
}
.cart-header {
  width: 100%;
  background: #fff;
  border-radius: 24px 24px 0 0;
  padding: 18px 16px 12px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -10px 25px rgba(0, 0, 0, 0.12);
  flex-shrink: 0;
}
.cart-label {
  margin: 0;
  color: var(--muted-color);
  font-size: 0.76rem;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
.cart-header h2 {
  margin: 4px 0 0;
  font-size: 1.4rem;
}
.close-cart {
  border: none;
  background: #edf5ef;
  color: var(--primary-dark);
  width: 38px;
  height: 38px;
  border-radius: 12px;
  cursor: pointer;
  font-size: 1.1rem;
}
.cart-items {
  width: 100%;
  background: #fff;
  overflow-y: auto;
  padding: 0 16px 12px;
  flex: 1 1 auto;
  min-height: 0;
  -webkit-overflow-scrolling: touch;
}
.cart-item {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 12px;
  padding: 14px 0;
  border-bottom: 1px solid var(--border-color);
}
.cart-item-info h4 {
  margin: 0 0 4px;
  font-size: 0.96rem;
}
.cart-item-info p {
  margin: 0;
  color: var(--muted-color);
  font-size: 0.8rem;
}
.cart-item-controls {
  display: flex;
  align-items: center;
  gap: 8px;
}
.qty-button,
.remove-item {
  border: none;
  border-radius: 10px;
  cursor: pointer;
}
.qty-button {
  width: 28px;
  height: 28px;
  background: #edf5ef;
  color: var(--primary-dark);
  font-weight: 700;
}
.cart-item-qty {
  min-width: 22px;
  text-align: center;
  font-weight: 700;
}
.remove-item {
  background: transparent;
  color: #b42318;
  padding: 4px 0;
  font-size: 0.75rem;
  grid-column: 1 / -1;
  justify-self: end;
}
.cart-summary {
  width: 100%;
  background: #fff;
  border-radius: 24px 24px 0 0;
  padding: 16px;
  box-shadow: 0 -10px 25px rgba(0, 0, 0, 0.08);
  flex-shrink: 0;
}
.summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10px;
  color: var(--muted-color);
  gap: 10px;
}
.total-row {
  font-size: 1.1rem;
  color: var(--text-color);
  margin-bottom: 0;
}
.empty-cart {
  padding: 20px 0;
  text-align: center;
  color: var(--muted-color);
}
.checkout-panel {
  position: fixed;
  inset: 0;
  background: rgba(17, 24, 39, 0.4);
  display: flex;
  justify-content: center;
  align-items: flex-end;
  z-index: 40;
}
.checkout-panel.hidden {
  display: none;
}
.admin-panel {
  position: fixed;
  inset: 0;
  display: flex;
  justify-content: center;
  align-items: flex-end;
  padding: 0;
  background: rgba(17, 24, 39, 0.4);
  z-index: 50;
}
.admin-panel.hidden {
  display: none;
}
.admin-sheet {
  display: flex;
  flex-direction: column;
  width: min(100%, 720px);
  max-height: min(92vh, 900px);
  overflow: hidden;
  background: var(--bg-color);
  border-radius: 24px 24px 0 0;
  box-shadow: 0 -10px 25px rgba(0, 0, 0, 0.12);
}
.admin-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 18px 16px 12px;
  background: #fff;
  border-radius: 24px 24px 0 0;
  flex-shrink: 0;
}
.admin-header h2 {
  margin: 4px 0 0;
  font-size: 1.4rem;
}
.admin-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 12px 16px;
  border-top: 1px solid var(--border-color);
  border-bottom: 1px solid var(--border-color);
  background: #f8faf7;
  color: var(--muted-color);
  font-size: 0.84rem;
  flex-shrink: 0;
}
.admin-toolbar strong {
  color: var(--text-color);
}
.admin-operation-controls,
.admin-order-filters,
.admin-product-controls {
  padding: 12px 16px;
  background: #fff;
  border-bottom: 1px solid var(--border-color);
}
.admin-store-toggle {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--text-color);
  font-size: 0.8rem;
  font-weight: 700;
  cursor: pointer;
}
.admin-store-toggle input,
.admin-product-toggle input {
  accent-color: var(--primary-color);
}
.store-status-message {
  margin-left: 8px;
  color: var(--primary-dark);
  font-size: 0.76rem;
}
.store-status-message.closed {
  color: #b42318;
}
.admin-order-filters {
  display: grid;
  grid-template-columns: minmax(0, 1.5fr) repeat(2, minmax(0, 1fr));
  gap: 8px;
  background: #f8faf7;
}
.admin-filter-field {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
}
.admin-filter-input,
.admin-filter-select {
  width: 100%;
  min-width: 0;
  border: 1px solid var(--border-color);
  border-radius: 10px;
  padding: 9px 10px;
  background: #fff;
  color: var(--text-color);
  font-size: 0.78rem;
}
.admin-product-controls {
  flex-shrink: 0;
  border-top: 1px solid var(--border-color);
}
.admin-product-controls .admin-section-heading {
  margin-bottom: 10px;
}
.admin-product-controls .admin-section-heading h3 {
  font-size: 0.82rem;
}
.admin-product-availability-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px 16px;
  max-height: 150px;
  overflow-y: auto;
}
.admin-product-store-group {
  display: grid;
  gap: 6px;
  min-width: 0;
}
.admin-product-store-group > strong {
  color: var(--primary-dark);
  font-size: 0.76rem;
}
.admin-product-toggle-list {
  display: grid;
  gap: 5px;
}
.admin-product-toggle {
  display: flex;
  align-items: flex-start;
  gap: 6px;
  min-width: 0;
