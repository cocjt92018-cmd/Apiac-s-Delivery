  function migrateCommerceCatalog() {
    // Import the existing demonstration catalog once; retain all legacy keys.
    const legacy = readCommerceStorage('apiacasCommerceData', {});
    if (localStorage.getItem(COMMERCES_KEY) === null) writeStorage(COMMERCES_KEY, stores.map((store, index) => ({ id: String(store.id), name: index === 0 ? legacy.name || store.name : store.name, owner: index === 0 ? legacy.responsible || '' : '', document: index === 0 ? legacy.document || '' : '', phone: index === 0 ? legacy.phone || '' : '', email: index === 0 ? 'comercio@teste.com' : '', password: null, category: store.category, address: { street: index === 0 ? legacy.address || '' : '', number: index === 0 ? legacy.number || '' : '', neighborhood: index === 0 ? legacy.neighborhood || '' : '', complement: '' }, businessHours: { opening: '', closing: '' }, hours: index === 0 ? legacy.hours || store.time : store.time, status: index === 0 ? legacy.accountStatus || 'active' : 'active', isOpen: index === 0 ? legacy.isOpen ?? getStoreSettings().isOpen ?? true : true, delivery: store.delivery, rating: store.rating })));
    if (localStorage.getItem(PRODUCTS_KEY) === null) {
      const saved = readCommerceStorage(PRODUCTS_STORAGE_KEY, {}), availability = getProductAvailability();
      writeStorage(PRODUCTS_KEY, stores.flatMap(store => (saved[store.id] || store.products).map(product => ({ ...product, id: createId('product'), commerceId: String(store.id), category: product.category || store.category, type: product.type || 'product', preparationTime: product.preparationTime || 0, available: product.available !== false && availability[getProductKey(store.id, product.name)] !== false }))));
    }
  }
  // Administração geral: autorização sempre consultada no banco; dados não são cacheados.
