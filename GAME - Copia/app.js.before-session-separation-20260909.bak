  const generalFields = [
    ['name','Nome'], ['responsible_name','Responsável'], ['responsible_cpf','CPF do responsável'], ['company_cnpj','CNPJ da empresa'],
    ['phone','Telefone'], ['email','E-mail'], ['category','Categoria'], ['street','Endereço'],
    ['number','Número'], ['neighborhood','Bairro'], ['complement','Complemento'],
    ['opening_time','Abertura'], ['closing_time','Fechamento'], ['delivery_fee','Taxa de entrega']
