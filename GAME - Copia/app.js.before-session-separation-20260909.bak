  function saveAdminPreview() {
    if (!adminPreviewMode) localStorage.removeItem(ADMIN_PREVIEW_KEY);
    else localStorage.setItem(ADMIN_PREVIEW_KEY, JSON.stringify({ mode: adminPreviewMode, commerceId: adminPreviewCommerceId }));
  }
  async function loadAdminPreviewCommerces() {
    const localCommerces = readStorage(COMMERCES_KEY, []);
    let commerces = localCommerces;
    if (supabaseClient) {
      const result = await supabaseClient.from('commerces').select('*').order('name');
      if (!result.error && result.data?.length) {
        result.data.forEach(cacheCommerce);
        commerces = readStorage(COMMERCES_KEY, []);
      }
    }
    return commerces;
  }
  async function activateAdminPreview(mode, commerceId = null) {
    if (!currentUser || !adminSession) return;
    adminPreviewMode = mode || null;
    if (mode === 'commerce' && !commerceId) {
      const commerces = await loadAdminPreviewCommerces();
      commerceId = commerces[0]?.id || null;
    }
    adminPreviewCommerceId = mode === 'commerce' ? commerceId : null;
    currentCommerceId = adminPreviewCommerceId;
    masterMode = false;
    saveAdminPreview();
    generalPanel.classList.add('hidden');
    if (adminPreviewMode === 'customer') showClientApp();
    if (adminPreviewMode === 'commerce') showCommercePanel('admin');
    updateModeSwitcherVisibility();
  }
  async function restoreAdminPreview() {
    try {
      const preview = JSON.parse(localStorage.getItem(ADMIN_PREVIEW_KEY) || 'null');
      if (!preview?.mode) return;
      await activateAdminPreview(preview.mode, preview.commerceId);
    } catch { localStorage.removeItem(ADMIN_PREVIEW_KEY); }
  }
  function returnToGeneralAdmin() {
    adminPreviewMode = null;
    adminPreviewCommerceId = null;
    currentCommerceId = null;
    masterMode = false;
    saveAdminPreview();
    updateModeSwitcherVisibility();
    document.querySelectorAll('[data-mode-option]').forEach(button => {
      button.classList.toggle('active', button.dataset.modeOption === 'admin');
      button.disabled = false;
    });
    [clientApp, adminPanel, menuPanel, cartPanel, checkoutPanel, cartButton].forEach(panel => panel.classList.add('hidden'));
    generalPanel.classList.remove('hidden');
    renderGeneralAdmin();
  }
  function clearGeneralAdmin() {
    generalRequest++;
    generalCommerceId = null;
    generalPanel.classList.add('hidden');
    generalList.innerHTML = '';
    document.getElementById('generalAdminDashboard').innerHTML = '';
    document.getElementById('generalAdminProfileDetails').innerHTML = '';
    document.getElementById('generalAdminCommerceFields').innerHTML = '';
    generalDetails.classList.add('hidden');
    generalForm.classList.add('hidden');
    document.getElementById('generalAdminPassword').value = '';
  }
  async function requireGeneralAdmin() {
    if (!supabaseClient) throw new Error(supabaseUnavailableMessage);
    const sessionResult = await supabaseClient.auth.getSession();
    const user = sessionResult.data?.session?.user;
    if (sessionResult.error) throw sessionResult.error;
    const result = user ? await supabaseClient.rpc('is_admin') : { data: false };
    if (result.error || result.data !== true || user.id !== currentUser?.id) {
      clearGeneralAdmin();
      if (currentProfile === 'admin') {
        currentProfile = null;
        adminSession = false;
        authScreen.classList.remove('hidden');
        showProfileSelection();
      }
      throw result.error || new Error('Acesso administrativo não autorizado.');
    }
    return user;
  }
  async function routeGeneralAdmin() {
    try {
      const result = await supabaseClient.rpc('is_admin');
      if (result.error) { console.error('Não foi possível verificar administrador:', result.error.code); return false; }
      if (result.data !== true) return false;
      await requireGeneralAdmin();
      currentProfile = 'admin'; adminSession = true; masterMode = false; currentCommerceId = null;
      closeClientOrders(); closeAdminMenu(); stopCustomerOrderTracking();
      if (adminRefreshTimer !== null) { window.clearInterval(adminRefreshTimer); adminRefreshTimer = null; }
      [authScreen, clientApp, adminPanel, menuPanel, cartPanel, checkoutPanel, cartButton].forEach(panel => panel.classList.add('hidden'));
      generalPanel.classList.remove('hidden');
      updateModeSwitcherVisibility();
      document.querySelectorAll('[data-mode-option]').forEach(button => {
        button.classList.toggle('active', button.dataset.modeOption === 'admin');
        button.disabled = false;
      });
      document.getElementById('generalAdminPassword').value = '';
      generalPage = 'dashboard'; generalOffset = 0;
      await renderGeneralAdmin();
      await restoreAdminPreview();
      return true;
    } catch (error) { console.error('Falha ao abrir administrador:', error.code || error.message); return false; }
  }
  function generalError(error) {
    console.error('Falha na administração geral:', error.code || error.message);
    generalMessage.textContent = 'Não foi possível carregar ou salvar. Confira sua permissão e se o SQL administrativo foi aplicado.';
    generalMessage.classList.add('error');
  }
  async function renderGeneralAdmin() {
    const request = ++generalRequest;
    generalMessage.textContent = 'Carregando...'; generalMessage.classList.remove('error');
    generalDetails.classList.add('hidden'); generalCommerceId = null;
    generalList.innerHTML = '';
    document.getElementById('generalAdminDashboard').innerHTML = '';
    try {
      await requireGeneralAdmin();
      document.querySelectorAll('[data-general-page]').forEach(button => {
        button.classList.toggle('active', button.dataset.generalPage === generalPage);
        button.setAttribute('aria-pressed', String(button.dataset.generalPage === generalPage));
      });
      document.getElementById('generalAdminDashboard').classList.toggle('hidden', generalPage !== 'dashboard');
      document.getElementById('generalAdminDirectory').classList.toggle('hidden', generalPage === 'dashboard');
      if (generalPage === 'dashboard') {
        const results = await Promise.all([
          supabaseClient.from('profiles').select('id', { count: 'exact', head: true }),
          supabaseClient.from('commerces').select('id', { count: 'exact', head: true }),
          supabaseClient.from('commerces').select('id', { count: 'exact', head: true }).eq('status','active'),
          supabaseClient.from('commerces').select('id', { count: 'exact', head: true }).eq('status','inactive')
        ]);
        const failure = results.find(result => result.error); if (failure) throw failure.error;
        if (request !== generalRequest) return;
        document.getElementById('generalAdminDashboard').innerHTML = results.map((result,i) => `<div><span>${['Usuários','Comércios','Ativos','Inativos'][i]}</span><strong>${result.count ?? 0}</strong></div>`).join('');
      } else {
        const table = generalPage === 'commerces' ? 'commerces' : 'profiles';
        let query = supabaseClient.from(table).select(table === 'commerces' ? 'id,name,email,status' : 'id,name,email', { count: 'exact' });
        const search = document.getElementById('generalAdminSearch').value.trim();
        if (search) {
          if (table === 'profiles' && /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(search)) query = query.eq('id', search);
          else query = query.ilike(table === 'profiles' && search.includes('@') ? 'email' : 'name', '%' + search.replace(/[\\%_]/g, '\\$&') + '%');
        }
        const result = await query.order('name').order('id').range(generalOffset, generalOffset + 49);
        if (result.error) throw result.error;
        if (request !== generalRequest) return;
        generalList.innerHTML = (result.data || []).map(item => `<article class="client-order-card"><strong>${escapeAdminValue(item.name || item.email || item.id)}</strong><p>${escapeAdminValue(item.email || '')}${item.status ? ' · ' + escapeAdminValue(item.status) : ''}</p><button class="checkout-back-button" type="button" data-general-open="${escapeAdminValue(item.id)}">${table === 'commerces' ? 'Ver comércio' : 'Abrir perfil'}</button></article>`).join('') || '<p>Nenhum cadastro encontrado.</p>';
        document.getElementById('generalAdminPrevious').disabled = generalOffset === 0;
        document.getElementById('generalAdminNext').disabled = generalOffset + 50 >= (result.count || 0);
        document.getElementById('generalAdminPageNumber').textContent = `Página ${generalOffset / 50 + 1} · ${result.count || 0} cadastros`;
      }
      if (request === generalRequest) generalMessage.textContent = '';
    } catch (error) { if (request === generalRequest) generalError(error); }
  }
  async function openGeneralProfile(id) {
    const request = ++generalRequest;
    generalDetails.classList.add('hidden'); generalCommerceId = null;
    const table = generalPage === 'commerces' ? 'commerces' : 'profiles';
    try {
      await requireGeneralAdmin();
      const result = await supabaseClient.from(table).select('*').eq('id',id).single();
      if (result.error) throw result.error;
      if (request !== generalRequest) return;
      const item = result.data;
      document.getElementById('generalAdminProfileDetails').innerHTML = `<h2>${escapeAdminValue(item.name || item.email || 'Perfil')}</h2><p>UUID: ${escapeAdminValue(item.id)}</p>`;
      generalForm.classList.toggle('hidden', table !== 'commerces');
      if (table === 'commerces') {
        generalCommerceId = item.id;
        document.getElementById('generalAdminCommerceFields').innerHTML = generalFields.map(([name,label]) => {
          const type = name.endsWith('_time') ? 'time' : name === 'delivery_fee' ? 'number' : name === 'email' ? 'email' : 'text';
          return `<label class="commerce-field">${label}<input name="${name}" type="${type}" ${type === 'email' ? 'maxlength="254" autocomplete="email"' : ''} ${type === 'number' ? 'min="0" step="0.01"' : ''} ${name === 'complement' ? '' : 'required'} value="${escapeAdminValue(item[name] ?? '')}" /></label>`;
        }).join('') + `<label class="commerce-field">Status<select name="status"><option value="pendente_aprovacao" ${item.status === 'pendente_aprovacao' ? 'selected' : ''}>Pendente de aprovação</option><option value="active" ${item.status === 'active' ? 'selected' : ''}>Ativo</option><option value="inactive" ${item.status === 'inactive' ? 'selected' : ''}>Inativo</option></select></label><label class="commerce-toggle">Aberto<input name="is_open" type="checkbox" ${item.is_open ? 'checked' : ''} /></label>`;
        document.getElementById('generalAdminProfileDetails').innerHTML += `<p>Proprietário: ${escapeAdminValue(item.owner_id)}</p>`;
      } else {
        document.getElementById('generalAdminProfileDetails').innerHTML += `<dl class="commerce-registration">${[['name','Nome'],['phone','Telefone'],['email','E-mail'],['created_at','Cadastro']].map(([key,label]) => `<div><dt>${label}</dt><dd>${escapeAdminValue(item[key] || 'Não informado')}</dd></div>`).join('')}</dl>`;
      }
      generalDetails.classList.remove('hidden'); generalDetails.scrollIntoView({ block: 'start' });
    } catch (error) { if (request === generalRequest) generalError(error); }
  }
  generalForm.addEventListener('submit', async event => {
    event.preventDefault();
    if (!generalCommerceId || !generalForm.reportValidity() || generalForm.dataset.saving === 'true') return;
    const id = generalCommerceId, request = generalRequest;
    const values = Object.fromEntries(generalFields.map(([name]) => [name,generalForm.elements.namedItem(name).value.trim()]));
    values.delivery_fee = Number(values.delivery_fee);
    values.status = generalForm.elements.namedItem('status').value;
    values.is_open = generalForm.elements.namedItem('is_open').checked;
    if (!Number.isFinite(values.delivery_fee) || values.delivery_fee < 0) return;
    generalForm.dataset.saving = 'true';
    const saveButton = generalForm.querySelector('button[type="submit"]'); saveButton.disabled = true;
    try {
      await requireGeneralAdmin();
      const result = await supabaseClient.from('commerces').update(values).eq('id',id).select('*').single();
      if (result.error) throw result.error;
      if (request !== generalRequest) return;
      await renderGeneralAdmin(); await openGeneralProfile(id);
      generalMessage.textContent = 'Comércio atualizado com sucesso.';
    } catch (error) { if (request === generalRequest) generalError(error); }
    finally { delete generalForm.dataset.saving; saveButton.disabled = false; }
  });
  document.getElementById('generalAdminProfileButton').addEventListener('click', () => {
    const form = document.getElementById('generalAdminLoginForm');
    hideAuthViews(); form.classList.remove('hidden');
    loadRememberedEmail(document.getElementById('generalAdminEmail'), document.getElementById('generalAdminPassword'), form);
    document.getElementById('generalAdminLoginError').textContent = ''; document.getElementById('generalAdminEmail').focus();
  });
  document.getElementById('generalAdminLoginForm').addEventListener('submit', async event => {
    event.preventDefault();
    if (authRequestPending) return;
    const message = document.getElementById('generalAdminLoginError');
    if (!supabaseClient) { message.textContent = supabaseUnavailableMessage; return; }
    authRequestPending = true;
    message.textContent = 'Entrando...';
    try {
      const result = await supabaseClient.auth.signInWithPassword({ email: normalizeEmail(document.getElementById('generalAdminEmail').value), password: document.getElementById('generalAdminPassword').value });
      if (result.error || !result.data.user) throw result.error || new Error('Login indisponível');
      await askRememberUser(normalizeEmail(document.getElementById('generalAdminEmail').value));
      currentUser = result.data.user;
      if (!await routeGeneralAdmin()) { message.textContent = 'Acesso administrativo não autorizado ou indisponível. Entre pelo perfil de cliente ou comércio.'; return; }
      message.textContent = '';
    } catch (error) { console.error('Falha no login administrativo:', error.code || error.message); message.textContent = 'Não foi possível entrar. Confira os dados e a confirmação do e-mail.'; }
    finally { authRequestPending = false; }
  });
  document.querySelectorAll('[data-general-page]').forEach(button => button.addEventListener('click', () => {
    generalPage = button.dataset.generalPage; generalOffset = 0;
    const search = document.getElementById('generalAdminSearch'); search.value = '';
    search.placeholder = generalPage === 'profiles' ? 'Nome, e-mail ou UUID' : 'Pesquisar por nome';
    search.setAttribute('aria-label', search.placeholder);
    renderGeneralAdmin();
  }));
  document.getElementById('generalAdminSearchForm').addEventListener('submit', event => { event.preventDefault(); generalOffset = 0; renderGeneralAdmin(); });
  generalList.addEventListener('click', event => { const button = event.target.closest('[data-general-open]'); if (button) openGeneralProfile(button.dataset.generalOpen); });
  document.getElementById('generalAdminPrevious').addEventListener('click', () => { generalOffset = Math.max(0,generalOffset - 50); renderGeneralAdmin(); });
  document.getElementById('generalAdminNext').addEventListener('click', () => { generalOffset += 50; renderGeneralAdmin(); });
  document.getElementById('generalAdminCloseDetails').addEventListener('click', () => { generalRequest++; generalCommerceId = null; generalDetails.classList.add('hidden'); });
  document.getElementById('generalAdminLogout').addEventListener('click', logout);
  if (supabaseClient?.auth.onAuthStateChange) supabaseClient.auth.onAuthStateChange(event => {
    if (event === 'PASSWORD_RECOVERY') {
      showResetPasswordScreen();
      return;
    }
    if (event === 'SIGNED_OUT') {
      const wasAdmin = currentProfile === 'admin'; clearGeneralAdmin();
      if (wasAdmin) { currentProfile = null; currentUser = null; authScreen.classList.remove('hidden'); showProfileSelection(); }
    }
  });
  try { migrateCommerceCatalog(); } catch { showStatus('Não foi possível carregar o cadastro local. Verifique o armazenamento do navegador.'); }
  loadCommerceProducts();
  applyAppTheme();
  closeAdminMenu();
  renderCategories();
  renderStores();
  renderCart();
  function moveSupportCarousel(direction) {
    const firstCard = supportCarousel.children[0];
    const width = firstCard.getBoundingClientRect().width + 14;
    const maxPosition = supportCarousel.scrollWidth - supportCarousel.clientWidth;
    const nextPosition = supportCarousel.scrollLeft + direction * width;
    supportCarousel.scrollTo({ left: nextPosition < 0 ? maxPosition : nextPosition > maxPosition ? 0 : nextPosition, behavior: 'smooth' });
  }
  setInterval(() => {
    if (clientApp.classList.contains('hidden')) return;
    moveSupportCarousel(1);
  }, 10000);
  if (isPasswordRecoveryRedirect()) showResetPasswordScreen();
  else restoreSession();
  document.querySelectorAll('[data-password-target]').forEach(button => {
    button.addEventListener('click', () => {
      const input = document.getElementById(button.dataset.passwordTarget);
      if (!input) return;
      const mostrar = input.type === 'password';
      input.type = mostrar ? 'text' : 'password';
      button.textContent = mostrar ? 'Ocultar' : 'Mostrar';
    });
  });
