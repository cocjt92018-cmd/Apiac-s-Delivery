    const cnpjInput = document.createElement('input');
    cnpjInput.id = 'registerCommerceCompanyCnpj';
    cnpjInput.type = 'text';
    cnpjInput.inputMode = 'numeric';
    cnpjInput.maxLength = 18;
    cnpjInput.required = true;
    cnpjLabel.appendChild(cnpjInput);
    cpfInput.closest('label').after(cnpjLabel);
  }
  ensureCommerceIdentityFields();
