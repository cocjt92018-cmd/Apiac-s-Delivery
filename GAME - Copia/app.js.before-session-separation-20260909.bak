  function ensureCommerceIdentityFields() {
    const cpfInput = document.getElementById('registerCommerceDocument');
    if (!cpfInput) return;
    cpfInput.id = 'registerCommerceResponsibleCpf';
    cpfInput.inputMode = 'numeric';
