  function getSalesReport(period) {
    const start = new Date(); start.setHours(0, 0, 0, 0);
    if (period !== 'all') start.setDate(start.getDate() - Number(period) + 1);
    const groups = new Map();
    const orders = getSavedOrders().filter(order => {
      if (String((order.commerceId || '1')) !== String(currentCommerceId)) return false;
      const date = new Date(order.data);
      return order.status === 'Entregue' && Number.isFinite(date.getTime()) && date <= new Date() && (period === 'all' || date >= start);
    });
    let total = 0, units = 0;
    orders.forEach(order => {
      const amount = Math.max(0, Number(order.subtotal ?? (Number(order.total) - Number(order.taxaEntrega || 0))) || 0);
      const date = new Date(order.data);
      const key = `${date.getFullYear()}-${String(date.getMonth()+1).padStart(2,'0')}-${String(date.getDate()).padStart(2,'0')}`;
      groups.set(key, (groups.get(key) || 0) + amount); total += amount;
      units += (order.itens || []).reduce((sum, item) => sum + (Number(item.quantidade) || 0), 0);
    });
    return { total, units, count: orders.length, groups: [...groups.entries()].sort(([a],[b]) => a.localeCompare(b)) };
  }
  function renderSalesReport() {
    if (!isCommerceSession()) return;
    const report = getSalesReport(document.getElementById('reportPeriod').value);
    document.getElementById('salesMetrics').innerHTML = [['Vendido', formatCurrency(report.total)], ['Pedidos entregues', report.count], ['Itens vendidos', report.units], ['Ticket médio', formatCurrency(report.count ? report.total / report.count : 0)]].map(([label, value]) => `<div><span>${label}</span><strong>${value}</strong></div>`).join('');
    const max = Math.max(1, ...report.groups.map(([,value]) => value));
    document.getElementById('salesChart').innerHTML = report.groups.map(([day,value]) => `<div class="sales-chart-row"><span>${day.split('-').reverse().join('/')}</span><div class="sales-chart-track" aria-hidden="true"><div style="width:${value/max*100}%"></div></div><strong>${formatCurrency(value)}</strong></div>`).join('') || '<p>Nenhuma venda concluída neste período.</p>';
  }
  document.getElementById('reportPeriod').addEventListener('change', renderSalesReport);
