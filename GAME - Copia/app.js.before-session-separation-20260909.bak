  const PAYMENT_LABELS = {
    pix: 'PIX',
    cash: 'Dinheiro',
    card: 'Cartão na entrega', credit: 'Crédito na entrega', debit: 'Débito na entrega'
  };
  let selectedCategory = 'Todos';
  const cart = [];
  let isSubmittingOrder = false;
  let activeCustomerOrderNumber = null;
  let customerOrderRefreshTimer = null;
  let currentProfile = null;
  let currentUser = null;
  let currentCommerceId = null;
  let adminPreviewMode = null;
  let adminPreviewCommerceId = null;
  let adminSession = false;
  let authRequestPending = false;
  let clientOrdersTimer = null;
  let masterMode = false;
  document.querySelectorAll('input[type="email"]').forEach(input => { input.maxLength = 254; input.autocomplete = 'email'; });
  function isAdminPreview() { return currentUser && currentProfile === 'admin' && adminPreviewMode; }
  function isCustomerView() { return currentProfile === 'client' || (isAdminPreview() && adminPreviewMode === 'customer'); }
  function isMasterSession() { return currentProfile === 'master' || masterMode || (isAdminPreview() && adminPreviewMode === 'commerce'); }
  function isCommerceSession() { return currentProfile === 'commerce' || isMasterSession(); }
  function getActiveCommerceId() { return adminPreviewMode === 'commerce' ? adminPreviewCommerceId : currentCommerceId; }
  function updateModeSwitcherVisibility() {
    const modeSwitcher = document.getElementById('modeSwitcher');
    const isAuthenticatedAdmin = Boolean(currentUser && adminSession);
    modeSwitcher.classList.toggle('hidden', !isAuthenticatedAdmin);
    if (!isAuthenticatedAdmin) {
      modeSwitcher.classList.remove('open');
      document.getElementById('modeSwitcherButton').setAttribute('aria-expanded', 'false');
    }
  }
  function renderCategories() {
    categoryList.innerHTML = categories
      .map(
        (category) => `
          <button
            type="button"
            class="category-item ${category === selectedCategory ? 'active' : ''}"
            data-category="${category}"
          >
            ${category}
          </button>
        `
      )
      .join('');
    document.querySelectorAll('.category-item').forEach((button) => {
      button.addEventListener('click', () => {
        selectedCategory = button.dataset.category;
        renderCategories();
        renderStores();
      });
    });
  }
  function getFilteredStores() {
    const searchTerm = searchInput.value.trim().toLowerCase();
    return stores.filter((store) => {
      if (store.status !== 'active') return false;
      const matchesCategory = selectedCategory === 'Todos' || store.category === selectedCategory;
      const matchesSearch =
        store.name.toLowerCase().includes(searchTerm) ||
        store.category.toLowerCase().includes(searchTerm);
      return matchesCategory && matchesSearch;
    });
  }
  function showStatus(message) {
    statusMessage.textContent = message;
    statusMessage.classList.add('show');
    setTimeout(() => {
      statusMessage.classList.remove('show');
    }, 1800);
  }
  function hideAuthViews() {
    document.getElementById('generalAdminLoginForm').classList.add('hidden');
    document.getElementById('commerceRegisterForm').classList.add('hidden');
    forgotPasswordForm.classList.add('hidden');
    updatePasswordForm.classList.add('hidden');
    profileSelection.classList.add('hidden');
    clientLoginForm.classList.add('hidden');
    clientRegisterForm.classList.add('hidden');
    commerceLoginForm.classList.add('hidden');
  }
  function showProfileSelection() {
    hideAuthViews();
    profileSelection.classList.remove('hidden');
    clientLoginError.textContent = '';
    clientRegisterError.textContent = '';
    commerceLoginError.textContent = '';
  }
  function showClientLogin() {
    hideAuthViews();
    clientLoginForm.classList.remove('hidden');
    clientLoginError.textContent = '';
    loadRememberedEmail(clientEmailInput, clientPasswordInput, clientLoginForm);
    clientEmailInput.focus();
  }
  function showClientRegister() {
    hideAuthViews();
    clientRegisterForm.classList.remove('hidden');
    clientRegisterError.textContent = '';
    document.getElementById('registerClientName').focus();
  }
  function showCommerceLogin() {
    hideAuthViews();
    commerceLoginForm.classList.remove('hidden');
    commerceLoginError.textContent = '';
    loadRememberedEmail(commerceEmailInput, commercePasswordInput, commerceLoginForm);
    commerceEmailInput.focus();
  }
  function loadRememberedEmail(emailInput, passwordInput, form) {
    const savedEmail = localStorage.getItem('rememberedEmail');
    const useAnotherAccount = form.querySelector('[data-use-another-account]');
    if (savedEmail) {
      emailInput.value = savedEmail;
      emailInput.readOnly = true;
      passwordInput.value = '';
      useAnotherAccount.classList.remove('hidden');
    } else {
      emailInput.readOnly = false;
      useAnotherAccount.classList.add('hidden');
    }
  }
  function useAnotherAccount(emailInput, passwordInput, form) {
    localStorage.removeItem('rememberedEmail');
    emailInput.readOnly = false;
    emailInput.value = '';
    passwordInput.value = '';
    form.querySelector('[data-use-another-account]').classList.add('hidden');
    emailInput.focus();
  }
  function askRememberUser(email) {
    if (localStorage.getItem('rememberedEmail')) return Promise.resolve();
    return new Promise(resolve => {
      const close = () => {
        rememberUserModal.classList.add('hidden');
        rememberUserModal.setAttribute('aria-hidden', 'true');
        rememberUserYes.removeEventListener('click', remember); rememberUserNo.removeEventListener('click', close);
        resolve();
      };
      const remember = () => { localStorage.setItem('rememberedEmail', email.trim()); close(); };
      rememberUserYes.addEventListener('click', remember);
      rememberUserNo.addEventListener('click', close);
      rememberUserModal.classList.remove('hidden');
      rememberUserModal.setAttribute('aria-hidden', 'false');
      rememberUserYes.focus();
    });
  }
  function showForgotPassword(emailInputId) {
    hideAuthViews();
    forgotPasswordForm.classList.remove('hidden');
    document.getElementById('forgotPasswordEmail').value = document.getElementById(emailInputId).value;
    document.getElementById('forgotPasswordMessage').textContent = '';
    document.getElementById('forgotPasswordEmail').focus();
  }
  function isPasswordRecoveryRedirect() {
    return new URLSearchParams(window.location.hash.slice(1)).get('type') === 'recovery'
      || new URLSearchParams(window.location.search).get('type') === 'recovery';
  }
  function showResetPasswordScreen() {
    authScreen.classList.remove('hidden');
    [clientApp, adminPanel, generalPanel, menuPanel, cartPanel, checkoutPanel, cartButton].forEach(panel => panel.classList.add('hidden'));
    hideAuthViews();
    updatePasswordForm.classList.remove('hidden');
    document.getElementById('updatePasswordMessage').textContent = '';
    document.getElementById('newPassword').focus();
  }
  function saveSession(profile, commerceId = null, keepMasterMode = false) {
    localStorage.setItem(SESSION_STORAGE_KEY, JSON.stringify({
      loggedIn: true, profile, commerceId, masterMode: keepMasterMode
    }));
  }
  function showClientApp() {
    if (!isAdminPreview()) currentProfile = 'client';
    updateModeSwitcherVisibility();
    document.querySelectorAll('[data-mode-option]').forEach(button => {
      button.classList.toggle('active', button.dataset.modeOption === 'client');
      button.disabled = button.dataset.modeOption === 'admin' && currentProfile !== 'admin';
    });
    closeClientOrders();
    authScreen.classList.add('hidden');
    clientApp.classList.remove('hidden');
    cartButton.classList.remove('hidden');
    adminPanel.classList.add('hidden');
    adminPanel.setAttribute('aria-hidden', 'true');
    openAdminButton.classList.add('hidden');
    openAdminButton.setAttribute('aria-expanded', 'false');
  }
  function showCommercePanel(profile = 'commerce') {
    if (!isAdminPreview()) currentProfile = profile;
    updateModeSwitcherVisibility();
    document.querySelectorAll('[data-mode-option]').forEach(button => {
      button.classList.toggle('active', button.dataset.modeOption === 'commerce');
      button.disabled = button.dataset.modeOption === 'admin' && currentProfile !== 'admin';
    });
    resetProductEditor();
    closeClientOrders();
    authScreen.classList.add('hidden');
    clientApp.classList.add('hidden');
    cartButton.classList.add('hidden');
    openAdminButton.classList.remove('hidden');
    openAdminPanel();
  }
  function switchMasterToClient() {
    if (!isCommerceSession()) return;
    currentProfile = 'client';
    masterMode = true;
    saveSession('client', currentCommerceId, true);
    showClientApp();
  }
  function switchMasterToCommerce() {
    if (!isMasterSession()) return;
    currentProfile = 'master';
    saveSession('master', currentCommerceId, true);
    showCommercePanel('master');
  }
  function getOAuthRole() {
    const role = new URLSearchParams(window.location.search).get('oauth_role');
    return role === 'commerce' ? 'commerce' : role === 'client' ? 'client' : '';
  }
  function getOAuthSignup() {
    return new URLSearchParams(window.location.search).get('oauth_signup') === '1';
  }
  async function continueWithGoogle(role, isSignup = false) {
    const message = role === 'commerce' ? commerceLoginError : clientLoginError;
    const registrationMessage = role === 'commerce' ? document.getElementById('commerceRegisterError') : clientRegisterError;
    if (!supabaseClient) { message.textContent = supabaseUnavailableMessage; return; }
    if (authRequestPending) return;
    if (isSignup && role === 'commerce') {
      const value = name => document.getElementById('registerCommerce' + name).value.trim();
      const required = ['Name', 'Owner', 'ResponsibleCpf', 'CompanyCnpj', 'Phone', 'Email', 'Category', 'Street', 'Number', 'Neighborhood', 'Opening', 'Closing'];
      if (required.some(name => !value(name))) { registrationMessage.textContent = 'Preencha os dados do comércio antes de continuar.'; return; }
      const pending = {
        name: value('Name'), responsible_name: value('Owner'), responsible_cpf: onlyNumbers(value('ResponsibleCpf')), company_cnpj: onlyNumbers(value('CompanyCnpj')),
        phone: onlyNumbers(value('Phone')), email: normalizeEmail(value('Email')), category: value('Category'),
        street: value('Street'), number: value('Number'), neighborhood: value('Neighborhood'),
        complement: value('Complement'), opening_time: normalizeBusinessTime(value('Opening')), closing_time: normalizeBusinessTime(value('Closing'))
      };
      if (!isValidCpf(pending.responsible_cpf)) { registrationMessage.textContent = 'CPF do responsável inválido.'; return; }
      if (!isValidCnpj(pending.company_cnpj)) { registrationMessage.textContent = 'CNPJ da empresa inválido.'; return; }
      if (!pending.opening_time || !pending.closing_time) { registrationMessage.textContent = 'Informe horários válidos.'; return; }
      savePendingCommerceRegistration(pending);
    }
    authRequestPending = true;
    (isSignup ? registrationMessage : message).textContent = 'Abrindo Google...';
    try {
      const { error } = await supabaseClient.auth.signInWithOAuth({
        provider: 'google',
        options: { redirectTo: `${window.location.origin}/?oauth_role=${role}${isSignup ? '&oauth_signup=1' : ''}` }
      });
      if (error) (isSignup ? registrationMessage : message).textContent = 'Não foi possível iniciar o login com Google.';
    } catch (error) {
      console.error('Falha no login Google:', error);
      (isSignup ? registrationMessage : message).textContent = 'Não foi possível iniciar o login com Google.';
    } finally {
      authRequestPending = false;
    }
  }
  async function ensureGoogleProfileType(user, role) {
    const { data, error } = await supabaseClient.from('profiles').select('profile_type').eq('id', user.id).maybeSingle();
    if (error) throw error;
    if (data?.profile_type) return data.profile_type;
    const profileType = role === 'commerce' ? 'comercio' : 'cliente';
    const { error: updateError } = await supabaseClient.auth.updateUser({ data: { profile_type: profileType } });
    if (updateError) throw updateError;
    return profileType;
  }
  async function registerClient(event) {
    event.preventDefault();
    if (!supabaseClient) { clientRegisterError.textContent = supabaseUnavailableMessage; return; }
    if (authRequestPending) return;
    if (!clientRegisterForm.reportValidity()) return;
    const name = document.getElementById('registerClientName').value.trim();
    const phone = document.getElementById('registerClientPhone').value.trim();
    const email = normalizeEmail(document.getElementById('registerClientEmail').value);
    const password = document.getElementById('registerClientPassword').value;
    const confirmation = document.getElementById('registerClientPasswordConfirm').value;
    if (password !== confirmation) { clientRegisterError.textContent = 'As senhas devem ser iguais.'; return; }
    authRequestPending = true;
    try {
      const { data, error } = await supabaseClient.auth.signUp({ email, password, options: { data: { name, phone } } });
      if (error) { clientRegisterError.textContent = error.message; return; }
      if (!data.session) { clientRegisterError.textContent = 'Cadastro criado. Confirme seu e-mail para entrar.'; return; }
      currentUser = data.user;
      clientRegisterForm.reset();
      showClientApp();
    } finally { authRequestPending = false; }
  }
  async function loginClient() {
    if (!supabaseClient) { clientLoginError.textContent = supabaseUnavailableMessage; return false; }
    if (authRequestPending) return false;
    const email = clientEmailInput.value.trim().toLowerCase();
    const password = clientPasswordInput.value;
    authRequestPending = true;
    try {
      const { data, error } = await supabaseClient.auth.signInWithPassword({ email, password });
      if (error || !data.user) { clientLoginError.textContent = error?.message || 'E-mail ou senha inválidos.'; return false; }
      await askRememberUser(email);
      masterMode = false;
      currentUser = data.user;
      if (await routeGeneralAdmin()) return true;
      showClientApp();
      return true;
    } finally { authRequestPending = false; }
  }
  async function loginCommerce() {
    if (!supabaseClient) { commerceLoginError.textContent = supabaseUnavailableMessage; return false; }
    if (authRequestPending) return false;
    authRequestPending = true;
    try {
    const email = normalizeEmail(commerceEmailInput.value);
    const password = String(commercePasswordInput.value);
    const { data, error } = await supabaseClient.auth.signInWithPassword({ email, password });
    if (error || !data.user) {
      console.error('Falha no login do comércio:', error?.code);
      commerceLoginError.textContent = error?.code === 'email_not_confirmed' ? 'Confirme seu e-mail antes de entrar.' : 'Não foi possível entrar. Confira seu e-mail e senha.';
      return false;
    }
    await askRememberUser(email);
    currentUser = data.user;
    let commerce;
    if (await routeGeneralAdmin()) return true;
    try { commerce = await completePendingCommerceRegistration(currentUser); }
    catch (failure) {
      console.error('Falha ao carregar comércio:', failure.code || failure.name);
      commerceLoginError.textContent = 'Não foi possível carregar ou concluir o cadastro do comércio. Tente entrar novamente.';
      return false;
    }
    if (!commerce) { currentCommerceId = null; commerceLoginError.textContent = 'Sua conta foi autenticada, mas o cadastro do comércio ainda não foi concluído.'; return false; }
    if (commerce.status !== 'active') { commerceLoginError.textContent = 'Cadastro enviado para análise administrativa.'; return false; }
    const cachedCommerce = cacheCommerce(commerce);
    currentCommerceId = cachedCommerce.id;
    masterMode = false;
    currentUser = data.user;
    showCommercePanel();
    return true;
    } catch (failure) {
      console.error('Falha de conexão no login:', failure.code || failure.name);
      commerceLoginError.textContent = 'Não foi possível conectar. Tente novamente.';
      return false;
    } finally { authRequestPending = false; }
  }
  async function logout() {
    try {
      const { error } = supabaseClient ? await supabaseClient.auth.signOut() : { error: null };
      if (error) showStatus('Não foi possível encerrar a sessão no servidor.');
    } catch (error) {
      console.error('Falha ao encerrar sessão:', error);
    }
    clearGeneralAdmin();
    currentProfile = null;
    currentUser = null;
    adminSession = false;
    cart.length = 0;
    renderCart();
    checkoutForm.reset();
    isSubmittingOrder = false;
    currentCommerceId = null;
    masterMode = false;
    adminPreviewMode = null;
    adminPreviewCommerceId = null;
    localStorage.removeItem(ADMIN_PREVIEW_KEY);
    updateModeSwitcherVisibility();
    document.getElementById('modeSwitcher').classList.add('hidden');
    closeClientOrders();
    [menuPanel, cartPanel, checkoutPanel].forEach(panel => { panel.classList.add('hidden'); panel.setAttribute('aria-hidden', 'true'); });
    clientPasswordInput.value = ''; commercePasswordInput.value = '';
    closeAdminOrderDetails();
    cancelOrderModal.classList.add('hidden');
    cancelOrderModal.setAttribute('aria-hidden', 'true');
    openAdminButton.classList.add('hidden');
    stopCustomerOrderTracking();
    closeAdminMenu();
    if (adminRefreshTimer !== null) {
      window.clearInterval(adminRefreshTimer);
      adminRefreshTimer = null;
    }
    adminPanel.classList.add('hidden');
    adminPanel.setAttribute('aria-hidden', 'true');
    cartButton.classList.add('hidden');
    openAdminButton.setAttribute('aria-expanded', 'false');
    clientApp.classList.add('hidden');
    authScreen.classList.remove('hidden');
    showProfileSelection();
  }
  async function restoreSession() {
    if (!supabaseClient) { showProfileSelection(); return; }
    const oauthRole = getOAuthRole();
    const oauthSignup = getOAuthSignup();
    const oauthError = new URLSearchParams(window.location.search).get('error_description');
    try {
    const { data: { session }, error } = await supabaseClient.auth.getSession();
    if (error || !session?.user) {
      if (oauthError && oauthSignup) {
        hideAuthViews();
        const form = oauthRole === 'commerce' ? document.getElementById('commerceRegisterForm') : clientRegisterForm;
        form.classList.remove('hidden');
        (oauthRole === 'commerce' ? document.getElementById('commerceRegisterError') : clientRegisterError).textContent = 'Cadastro Google cancelado ou não autorizado.';
      } else if (oauthError) {
        if (oauthRole === 'commerce') {
          showCommerceLogin();
          commerceLoginError.textContent = 'Login Google cancelado ou não autorizado.';
        } else {
          showClientLogin();
          clientLoginError.textContent = 'Login Google cancelado ou não autorizado.';
        }
      } else showProfileSelection();
      return;
    }
    currentUser = session.user;
    if (await routeGeneralAdmin()) return;
    let profileType = '';
    if (oauthRole) {
      try { profileType = await ensureGoogleProfileType(session.user, oauthRole || 'client'); }
      catch (failure) {
        console.error('Falha ao salvar tipo do perfil Google:', failure.code || failure.name);
        showStatus('Não foi possível concluir o cadastro Google.');
        return;
      }
    }
    if (profileType === 'admin') {
      showProfileSelection();
      showStatus('Contas Admin devem usar o acesso administrativo.');
      return;
    }
    if ((profileType === 'client' || profileType === 'cliente') && oauthRole !== 'commerce') {
      showClientApp();
      return;
    }
    let commerce;
    try { commerce = await completePendingCommerceRegistration(session.user); }
    catch (failure) {
      console.error('Falha ao restaurar comércio:', failure.code || failure.name);
      showCommerceLogin();
      commerceLoginError.textContent = failure.code === '23505' ? 'Este CNPJ já está cadastrado.' : 'Não foi possível carregar ou concluir o cadastro do comércio. Tente novamente.';
      return;
    }
    if (commerce && commerce.status === 'active') {
      const cachedCommerce = cacheCommerce(commerce);
      currentCommerceId = cachedCommerce.id;
      showCommercePanel();
    } else if (commerce) {
      showCommerceLogin();
      commerceLoginError.textContent = 'Cadastro enviado para análise administrativa.';
    } else if (profileType === 'commerce' || profileType === 'comercio' || oauthRole === 'commerce') {
      hideAuthViews();
      document.getElementById('commerceRegisterForm').classList.remove('hidden');
      document.getElementById('commerceRegisterError').textContent = 'Conclua os dados do comércio para finalizar o cadastro Google.';
    } else {
      showClientApp();
    }
    } catch (failure) {
      console.error('Falha ao restaurar sessão:', failure.code || failure.name);
      showProfileSelection();
      showStatus('Não foi possível restaurar sua sessão. Tente entrar novamente.');
    }
  }
  function openCart() {
    cartButton.classList.add('hidden');
    cartPanel.classList.remove('hidden');
    cartPanel.setAttribute('aria-hidden', 'false');
  }
  function closeCart() {
    cartButton.classList.remove('hidden');
    cartPanel.classList.add('hidden');
    cartPanel.setAttribute('aria-hidden', 'true');
  }
  function updateCartButton() {
    const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
    const subtotal = cart.reduce((sum, item) => sum + item.price * item.quantity, 0);

    cartCount.textContent = totalItems;

    if (cartTotalPreview) {
      cartTotalPreview.textContent =
        totalItems > 0 ? formatCurrency(subtotal) : '';
    }
  }
  function updateCartSummary() {
    const subtotal = cart.reduce((sum, item) => sum + item.price * item.quantity, 0);
    const total = subtotal;
    subtotalValue.textContent = `R$ ${subtotal.toFixed(2).replace('.', ',')}`;
    totalValue.textContent = `R$ ${total.toFixed(2).replace('.', ',')}`;
    finishOrderButton.disabled = cart.length === 0;
  }
  function formatCurrency(value) {
    return `R$ ${value.toFixed(2).replace('.', ',')}`;
  }
  function parseDeliveryFee(deliveryLabel) {
    if (typeof deliveryLabel === 'number') return Number.isFinite(deliveryLabel) ? Math.max(0, deliveryLabel) : 0;
    if (!deliveryLabel || deliveryLabel.toLowerCase().includes('grátis')) {
      return 0;
    }
    const numericValue = Number.parseFloat(
      deliveryLabel.replace('R$', '').replace('.', '').replace(',', '.').trim()
    );
    return Number.isFinite(numericValue) ? numericValue : 0;
  }
  function getCartDeliveryFee() {
    if (cart.length === 0) {
      return 0;
    }
    return cart[0].deliveryFee === undefined
      ? DELIVERY_FEE
      : Number(cart[0].deliveryFee) || 0;
  }
  function getNextOrderNumber() {
    const lastSequence = Number.parseInt(localStorage.getItem(ORDER_SEQUENCE_KEY) || '0', 10);
    const nextSequence = Number.isFinite(lastSequence) ? lastSequence + 1 : 1;
    localStorage.setItem(ORDER_SEQUENCE_KEY, String(nextSequence));
    return `APC-${String(nextSequence).padStart(4, '0')}`;
  }
  function getSavedOrders() {
    try {
      const savedOrders = JSON.parse(localStorage.getItem(ORDERS_STORAGE_KEY) || '[]');
      return Array.isArray(savedOrders) ? savedOrders : [];
    } catch (error) {
      return [];
    }
  }
  function getStoreSettings() {
    try {
      const settings = JSON.parse(localStorage.getItem(STORE_SETTINGS_KEY) || '{}');
      return settings && typeof settings === 'object' ? settings : {};
    } catch (error) {
      return {};
    }
  }
  function isStoreOpen(storeId = getActiveCommerceId() || cart[0]?.storeId) {
    const commerce = readStorage(COMMERCES_KEY, []).find(item => String(item.id) === String(storeId));
    return Boolean(commerce && commerce.status === 'active' && commerce.isOpen);
  }
  async function saveStoreOpenState(isOpen) {
    if (!isCommerceSession()) return;
    if (isAdminPreview()) {
      const commerces = readStorage(COMMERCES_KEY, []);
      const commerce = commerces.find(item => String(item.id) === String(getActiveCommerceId()));
      if (commerce) { commerce.isOpen = Boolean(isOpen); writeStorage(COMMERCES_KEY, commerces); loadCommerceProducts(); }
      return;
    }
    await updateLoggedCommerce({ isOpen: Boolean(isOpen) });
    localStorage.setItem(STORE_SETTINGS_KEY, JSON.stringify({
      ...getStoreSettings(),
      isOpen
    }));
  }
  function getProductAvailability() {
    try {
      const availability = JSON.parse(localStorage.getItem(PRODUCT_AVAILABILITY_KEY) || '{}');
      return availability && typeof availability === 'object' ? availability : {};
    } catch (error) {
      return {};
    }
  }
  function getProductKey(storeId, productName) {
    return `${storeId}-${productName}`;
  }
  function isProductAvailable(storeId, productName) {
    const product = readStorage(PRODUCTS_KEY, []).find(item => String(item.commerceId) === String(storeId) && item.name === productName);
    return Boolean(product && product.available !== false);
  }
  function saveProductAvailability(storeId, productName, available) {
    if (!isCommerceSession() || (!isMasterSession() && String(storeId) !== String(currentCommerceId))) return;
    const products = readStorage(PRODUCTS_KEY, []);
    const product = products.find(item => String(item.commerceId) === String(storeId) && item.name === productName);
    if (!product) return;
    product.available = Boolean(available);
    writeStorage(PRODUCTS_KEY, products);
    loadCommerceProducts();
    const availability = getProductAvailability();
    availability[getProductKey(storeId, productName)] = available;
    localStorage.setItem(PRODUCT_AVAILABILITY_KEY, JSON.stringify(availability));
  }
  function saveOrder(order) {
    const savedOrders = getSavedOrders();
    savedOrders.push(order);
    localStorage.setItem(ORDERS_STORAGE_KEY, JSON.stringify(savedOrders));
  }
  function buildOrderFromCheckout(formData, orderItems, paymentMethod, cashAmount, subtotal, total) {
    const orderNumber = getNextOrderNumber();
    return {
      commerceId: orderItems[0]?.storeId,
      customerId: currentUser?.id,
      customerEmail: normalizeEmail(currentUser?.email),
      numero: orderNumber,
      data: new Date().toISOString(),
      status: 'Novo',
      visualizado: false,
      cliente: {
        nome: String(formData.get('fullName') || '').trim(),
        telefone: String(formData.get('phone') || '').trim()
      },
      endereco: {
        rua: String(formData.get('address') || '').trim(),
        numero: String(formData.get('number') || '').trim(),
        bairro: String(formData.get('neighborhood') || '').trim(),
        complemento: String(formData.get('complement') || '').trim(),
        referencia: String(formData.get('reference') || '').trim()
      },
      itens: orderItems.map((item) => ({
        id: item.id, commerceId: item.storeId,
        nome: item.name,
        quantidade: item.quantity,
        preco: item.price,
        total: item.price * item.quantity
      })),
      subtotal,
      taxaEntrega: getCartDeliveryFee(),
      total,
      pagamento: {
        forma: PAYMENT_LABELS[paymentMethod],
        trocoPara: paymentMethod === 'cash' ? cashAmount : null,
        troco: paymentMethod === 'cash' ? cashAmount - total : null
      },
      observacao: String(formData.get('orderNote') || '').trim()
    };
  }
  function getCheckoutTotal() {
    const subtotal = cart.reduce((sum, item) => sum + item.price * item.quantity, 0);
    return subtotal + getCartDeliveryFee();
  }
  function getSelectedPaymentMethod() {
    return checkoutForm.querySelector('input[name="paymentMethod"]:checked')?.value || '';
  }
  function updatePaymentSummary() {
    const paymentMethod = getSelectedPaymentMethod();
    const cashAmount = Number(cashAmountInput.value);
    const total = getCheckoutTotal();
    if (!paymentMethod) {
      checkoutPaymentSummary.innerHTML = '';
      return;
    }
    checkoutPaymentSummary.innerHTML = `
      <div class="summary-row">
        <span>Forma de pagamento</span>
        <strong>${PAYMENT_LABELS[paymentMethod]}</strong>
      </div>
      ${paymentMethod === 'cash' && cashAmount >= total ? `
        <div class="summary-row">
          <span>Troco para</span>
          <strong>${formatCurrency(cashAmount)}</strong>
        </div>
        <div class="summary-row">
          <span>Troco</span>
          <strong>${formatCurrency(cashAmount - total)}</strong>
        </div>
      ` : ''}
    `;
  }
  function updateCashChange() {
    const paymentMethod = getSelectedPaymentMethod();
    const cashAmount = Number(cashAmountInput.value);
    const total = getCheckoutTotal();
    cashChangeGroup.classList.toggle('hidden', paymentMethod !== 'cash');
    cashAmountInput.required = paymentMethod === 'cash';
    if (paymentMethod !== 'cash') {
      cashChangeMessage.textContent = '';
      cashChangeMessage.classList.remove('error');
      updatePaymentSummary();
      return;
    }
    if (!cashAmountInput.value) {
      cashChangeMessage.textContent = '';
      cashChangeMessage.classList.remove('error');
    } else if (cashAmount < total) {
      cashChangeMessage.textContent = `O valor deve ser de pelo menos ${formatCurrency(total)}.`;
      cashChangeMessage.classList.add('error');
    } else {
      cashChangeMessage.textContent = `Troco: ${formatCurrency(cashAmount - total)}`;
      cashChangeMessage.classList.remove('error');
    }
    updatePaymentSummary();
  }
  function renderCart() {
    if (cart.length === 0) {
      cartItems.innerHTML = '<div class="empty-cart">Seu carrinho está vazio.</div>';
      updateCartSummary();
      updateCartButton();
      return;
    }
    cartItems.innerHTML = cart
      .map(
        (item) => `
          <div class="cart-item">
            <div class="cart-item-info">
              <h4>${item.name}</h4>
              <p>R$ ${item.price.toFixed(2).replace('.', ',')} cada</p>
            </div>
            <div class="cart-item-controls">
              <button class="qty-button" type="button" data-action="decrease" data-id="${item.id}">-</button>
              <span class="cart-item-qty">${item.quantity}</span>
              <button class="qty-button" type="button" data-action="increase" data-id="${item.id}">+</button>
            </div>
            <button class="remove-item" type="button" data-action="remove" data-id="${item.id}">Remover</button>
          </div>
        `
      )
      .join('');
    updateCartSummary();
    updateCartButton();
    document.querySelectorAll('[data-action]').forEach((button) => {
      button.addEventListener('click', () => {
        const action = button.dataset.action;
        const itemId = button.dataset.id;
        const itemIndex = cart.findIndex((item) => String(item.id) === String(itemId));
        if (itemIndex === -1) {
          return;
        }
        if (action === 'increase') {
          if (!isStoreOpen(cart[itemIndex].storeId) || !isProductAvailable(cart[itemIndex].storeId, cart[itemIndex].name)) {
            showStatus('Comércio fechado ou produto indisponível.');
            return;
          }
          cart[itemIndex].quantity += 1;
        }
        if (action === 'decrease') {
          cart[itemIndex].quantity -= 1;
          if (cart[itemIndex].quantity <= 0) {
            cart.splice(itemIndex, 1);
          }
        }
        if (action === 'remove') {
          cart.splice(itemIndex, 1);
        }
        renderCart();
      });
    });
  }
  function openCheckout() {
    if (cart.length === 0) {
      showStatus('Adicione produtos antes de finalizar o pedido.');
      return;
    }
    cartButton.classList.add('hidden');
    const subtotal = cart.reduce((sum, item) => sum + item.price * item.quantity, 0);
    const deliveryFee = getCartDeliveryFee();
    const total = subtotal + deliveryFee;
    checkoutSummaryList.innerHTML = cart
      .map(
        (item) => `
          <div class="checkout-summary-item">
            <span>${item.name} x${item.quantity}</span>
            <strong>R$ ${(item.price * item.quantity).toFixed(2).replace('.', ',')}</strong>
          </div>
        `
      )
      .join('');
    checkoutSubtotal.textContent = formatCurrency(subtotal);
    checkoutDeliveryFee.textContent = formatCurrency(deliveryFee);
    checkoutTotal.textContent = formatCurrency(total);
    closeCart();
    cartButton.classList.add('hidden');
    checkoutPanel.classList.remove('hidden');
    checkoutPanel.setAttribute('aria-hidden', 'false');
    checkoutForm.reset();
    syncCheckoutPayments();
    isSubmittingOrder = false;
    confirmOrderButton.disabled = !Object.keys(paymentDefaults).some(key => getPaymentSettings()[key] === true);
    updateCashChange();
    updatePaymentSummary();
    checkoutContent.classList.remove('hidden');
    checkoutSuccess.classList.add('hidden');
  }
  function closeCheckout() {
    stopCustomerOrderTracking();
    cartButton.classList.remove('hidden');
    checkoutPanel.classList.add('hidden');
    checkoutPanel.setAttribute('aria-hidden', 'true');
    checkoutForm.reset();
    checkoutContent.classList.remove('hidden');
    checkoutSuccess.classList.add('hidden');
  }
  function returnToCart() {
    closeCheckout();
    openCart();
  }
  function buildSuccessSummary(order) {
    const paymentSummary = `
      <div class="success-summary-item"><span>Forma de pagamento</span><strong>${order.pagamento.forma}</strong></div>
      ${order.pagamento.trocoPara !== null ? `
        <div class="success-summary-item"><span>Troco para</span><strong>${formatCurrency(order.pagamento.trocoPara)}</strong></div>
        <div class="success-summary-item"><span>Troco</span><strong>${formatCurrency(order.pagamento.troco)}</strong></div>
      ` : ''}
    `;
    return `
      <div class="success-summary-item"><span>Cliente</span><strong>${order.cliente.nome}</strong></div>
      <div class="success-summary-item"><span>Telefone</span><strong>${order.cliente.telefone}</strong></div>
      <div class="success-summary-item"><span>Endereço de entrega</span><strong>${order.endereco.rua}, ${order.endereco.numero}</strong></div>
      <div class="success-summary-item"><span>Bairro</span><strong>${order.endereco.bairro}</strong></div>
      ${order.endereco.complemento ? `<div class="success-summary-item"><span>Complemento</span><strong>${order.endereco.complemento}</strong></div>` : ''}
      ${order.endereco.referencia ? `<div class="success-summary-item"><span>Referência</span><strong>${order.endereco.referencia}</strong></div>` : ''}
      ${order.observacao ? `<div class="success-summary-item"><span>Observação</span><strong>${order.observacao}</strong></div>` : ''}
      <div class="success-summary-heading">Itens comprados</div>
    ` + order.itens
      .map(
        (item) => `
          <div class="success-summary-item">
            <span>${item.nome} x${item.quantidade}</span>
            <strong>${formatCurrency(item.total)}</strong>
          </div>
        `
      )
      .join('') + `
        <div class="success-summary-item">
          <span>Subtotal</span>
          <strong>${formatCurrency(order.subtotal)}</strong>
        </div>
        <div class="success-summary-item">
          <span>Taxa de entrega</span>
          <strong>${formatCurrency(order.taxaEntrega)}</strong>
        </div>
        <div class="success-summary-item">
          <span>Total</span>
          <strong>${formatCurrency(order.total)}</strong>
        </div>
      ` + paymentSummary;
  }
  function renderSuccessDeliveryStatus(order) {
    const statusLabels = {
      Novo: 'Pedido recebido',
      'Em preparo': 'Pedido em preparo',
      'Saiu para entrega': 'Pedido saiu para entrega',
      Entregue: 'Pedido entregue',
      Cancelado: 'Pedido cancelado'
    };
    successDeliveryStatus.innerHTML = `
      <strong>${statusLabels[order.status || 'Novo'] || 'Status do pedido'}</strong>
      ${order.status === 'Saiu para entrega' && order.entregadorNome ? `<span>Entregador: ${escapeAdminValue(order.entregadorNome)}</span>` : ''}
    `;
  }
  function refreshCustomerOrderStatus() {
    if (!activeCustomerOrderNumber) {
      return;
    }
    const order = getSavedOrders().find((item) => String(item.numero) === String(activeCustomerOrderNumber));
    if (order) {
      renderSuccessDeliveryStatus(order);
    }
  }
  function startCustomerOrderTracking(orderNumber) {
    activeCustomerOrderNumber = orderNumber;
    refreshCustomerOrderStatus();
    if (customerOrderRefreshTimer === null) {
      customerOrderRefreshTimer = window.setInterval(refreshCustomerOrderStatus, 5000);
    }
  }
  function stopCustomerOrderTracking() {
    activeCustomerOrderNumber = null;
    if (customerOrderRefreshTimer !== null) {
      window.clearInterval(customerOrderRefreshTimer);
      customerOrderRefreshTimer = null;
    }
  }
  function handleCheckoutSubmit(event) {
    event.preventDefault();
    if (!isCustomerView()) return;
    if (!currentUser?.id) {
      showStatus('Entre na sua conta para finalizar o pedido.');
      return;
    }
    if (!cart.length || !isStoreOpen(cart[0].storeId) || cart.some(item => String(item.storeId) !== String(cart[0].storeId) || !isProductAvailable(item.storeId, item.name))) { showStatus('O comércio está fechado ou há produtos indisponíveis no carrinho.'); return; }
    if (isSubmittingOrder) {
      return;
    }
    const formData = new FormData(checkoutForm);
    const fullName = String(formData.get('fullName') || '').trim();
    const phone = String(formData.get('phone') || '').trim();
    const address = String(formData.get('address') || '').trim();
    const number = String(formData.get('number') || '').trim();
    const neighborhood = String(formData.get('neighborhood') || '').trim();
    const paymentMethod = String(formData.get('paymentMethod') || '').trim();
    if (getPaymentSettings()[paymentMethod] !== true) { syncCheckoutPayments(); showStatus('Selecione uma forma de pagamento disponível.'); return; }
    const cashAmount = Number(formData.get('cashAmount'));
    const total = getCheckoutTotal();
    if (!fullName || !phone || !address || !number || !neighborhood || !paymentMethod) {
      showStatus('Preencha todos os campos obrigatórios.');
      return;
    }
    if (!Number.isFinite(total) || total <= 0 || cart.some(item => !Number.isFinite(item.price) || item.price <= 0 || !Number.isInteger(item.quantity) || item.quantity <= 0)) {
      showStatus('Há valores inválidos no carrinho. Remova os itens e adicione novamente.');
      return;
    }
    if (paymentMethod === 'cash' && (!Number.isFinite(cashAmount) || !cashAmount || cashAmount < total)) {
      cashChangeMessage.textContent = `O valor deve ser de pelo menos ${formatCurrency(total)}.`;
      cashChangeMessage.classList.add('error');
      cashAmountInput.focus();
      return;
    }
    const subtotal = cart.reduce((sum, item) => sum + item.price * item.quantity, 0);
    const orderItems = cart.map((item) => ({ ...item }));
    let order;
    try { order = buildOrderFromCheckout(formData, orderItems, paymentMethod, cashAmount, subtotal, total); saveOrder(order); } catch { showStatus('Não foi possível salvar o pedido. Tente novamente.'); return; }
    isSubmittingOrder = true;
    confirmOrderButton.disabled = true;
    successOrderNumber.textContent = `Pedido #${order.numero}`;
    renderSuccessDeliveryStatus(order);
    successSummary.innerHTML = buildSuccessSummary(order);
    startCustomerOrderTracking(order.numero);
    checkoutContent.classList.add('hidden');
    checkoutSuccess.classList.remove('hidden');
    showStatus('Pedido realizado com sucesso!');
    cart.length = 0;
    renderCart();
    updateCartButton();
  }
  function addProductToCart(product) {
    const price = Number(product.price);
    if (!Number.isFinite(price) || price <= 0) {
      showStatus('Preço do produto indisponível.');
      return;
    }
    if (!isCustomerView() || !isStoreOpen(product.storeId) || !isProductAvailable(product.storeId, product.name)) { showStatus('Comércio fechado ou produto indisponível.'); return; }
    if (cart.length && String(cart[0].storeId) !== String(product.storeId)) { showStatus('Escolha produtos de um comércio por pedido.'); return; }
    const existingItem = cart.find((item) => String(item.id) === String(product.id));
    if (existingItem) {
      existingItem.quantity += 1;
    } else {
      cart.push({ ...product, price, quantity: 1 });
    }
    renderCart();
    showStatus(`${product.name} adicionado ao carrinho`);
  }
  function openStoreMenu(storeId) {
    loadCommerceProducts();
    menuPanel.dataset.storeId = storeId;
    const store = stores.find((item) => String(item.id) === String(storeId));
    if (!store) {
      return;
    }
    menuStoreCategory.textContent = store.category;
    menuStoreName.textContent = store.name;
    menuStoreRating.textContent = `⭐ ${store.rating}`;
    menuProducts.innerHTML = store.products
      .map((product) => {
        const productAvailable = isProductAvailable(store.id, product.name);
        const canAddProduct = isStoreOpen(store.id) && productAvailable;
        return `
          <article class="product-item">
            <img src="${escapeAdminValue(product.image)}" alt="${escapeAdminValue(product.name)}" />
            <div class="product-info">
              <h3>${escapeAdminValue(product.name)}</h3>
              <p>${escapeAdminValue(product.description)}</p>
              <div class="product-footer">
                <strong>R$ ${product.price.toFixed(2).replace('.', ',')}</strong>
                <button
                  class="add-button"
                  type="button"
                  data-product-id="${escapeAdminValue(product.id)}"
                  data-product-name="${escapeAdminValue(product.name)}"
                  data-product-price="${product.price}"
                  data-store-id="${store.id}"
                  ${canAddProduct ? '' : 'disabled'}
                >
                  ${productAvailable ? (isStoreOpen(store.id) ? 'Adicionar ao carrinho' : 'Loja fechada') : 'Indisponível'}
                </button>
              </div>
            </div>
          </article>
        `;
      })
      .join('');
    menuPanel.classList.remove('hidden');
    menuPanel.setAttribute('aria-hidden', 'false');
    document.querySelectorAll('.add-button').forEach((button) => {
      button.addEventListener('click', () => {
        const productId = button.dataset.productId;
        const productName = button.dataset.productName;
        const productPrice = Number(button.dataset.productPrice);
        const storeId = button.dataset.storeId;
        const store = stores.find((item) => String(item.id) === String(storeId));
        if (!store || !isStoreOpen(store.id)) {
          showStatus('A loja está fechada no momento.');
          return;
        }
        if (!isProductAvailable(button.dataset.storeId, productName)) {
          showStatus('Este produto está indisponível no momento.');
          return;
        }
        if (cart.length > 0 && String(cart[0].storeId) !== String(storeId)) {
          if (!window.confirm('Seu carrinho possui produtos de outro comércio. Deseja limpá-lo?')) return;
          cart.splice(0, cart.length);
          renderCart();
        }
        addProductToCart({
          id: productId, productId, commerceId: storeId,
          name: productName,
          price: productPrice,
          storeId,
          storeName: store?.name || '',
          deliveryFee: parseDeliveryFee(store?.delivery)
        });
      });
    });
  }
  function closeStoreMenu() {
    menuPanel.classList.add('hidden');
    menuPanel.setAttribute('aria-hidden', 'true');
  }
  function renderStores() {
    loadCommerceProducts();
    const filteredStores = getFilteredStores();
    resultsCount.textContent = `${filteredStores.length} itens`;
    if (filteredStores.length === 0) {
      storeList.innerHTML = `
        <div class="empty-state">
          <p>Nenhum comércio encontrado.</p>
          <small>Tente outra busca ou categoria.</small>
        </div>
      `;
      return;
    }
    storeList.innerHTML = filteredStores
      .map(
        (store) => `
          <article class="store-card">
            <div class="store-header">
              <div class="store-badge">${store.icon}</div>
              <div class="store-main">
                <h3 class="store-name">${escapeAdminValue(store.name)}</h3>
                <p class="store-category">${escapeAdminValue(store.category)}</p>
              </div>
            </div>
            <div class="store-meta">
              <span class="store-rating">⭐ ${store.rating}</span>
              <span>${store.time}</span>
            </div>
            <div class="store-meta">
              <span>${store.delivery}</span>
              <span class="store-open-state ${isStoreOpen(store.id) ? '' : 'closed'}">${isStoreOpen(store.id) ? 'Aberto' : 'Fechada'}</span>
            </div>
            <button class="store-button" type="button" data-store-id="${store.id}">
              Abrir comércio
            </button>
          </article>
        `
      )
      .join('');
    document.querySelectorAll('.store-button').forEach((button) => {
      button.addEventListener('click', () => {
        const storeId = button.dataset.storeId;
        openStoreMenu(storeId);
      });
    });
  }
  const adminStatuses = ['Novo', 'Em preparo', 'Saiu para entrega', 'Entregue', 'Cancelado'];
  const openAdminButton = document.getElementById('openAdminButton');
  const closeAdminButton = document.getElementById('closeAdminButton');
  const refreshAdminButton = document.getElementById('refreshAdminButton');
  const adminPanel = document.getElementById('adminPanel');
  const adminMenuButton = document.getElementById('adminMenuButton');
  const adminSidebar = document.getElementById('adminSidebar');
  const adminMenuOverlay = document.getElementById('adminMenuOverlay');
  const adminPendingCount = document.getElementById('adminPendingCount');
  const adminUnreadCount = document.getElementById('adminUnreadCount');
  const adminHistoryCount = document.getElementById('adminHistoryCount');
  const adminPendingSectionCount = document.getElementById('adminPendingSectionCount');
  const adminHistorySectionCount = document.getElementById('adminHistorySectionCount');
  const adminPendingOrderList = document.getElementById('adminPendingOrderList');
  const adminHistoryOrderList = document.getElementById('adminHistoryOrderList');
  const storeOpenToggle = document.getElementById('storeOpenToggle');
  const storeStatusMessage = document.getElementById('storeStatusMessage');
  const adminStoreName = document.getElementById('adminStoreName');
  const adminProductAvailabilityList = document.getElementById('adminProductAvailabilityList');
  const adminProductSummary = document.getElementById('adminProductSummary');
  const adminPageTitle = document.getElementById('adminPageTitle');
  const adminNavigationButtons = document.querySelectorAll('[data-admin-page]');
  const adminPages = {
    profile: document.getElementById('adminStorePage'),
    orders: document.getElementById('adminOrdersPage'),
    products: document.getElementById('adminProductsPage'),
    reports: document.getElementById('adminReportsPage'),
    settings: document.getElementById('adminSettingsPage')
  };
  const adminDetailsModal = document.getElementById('adminDetailsModal');
  const closeAdminDetailsButton = document.getElementById('closeAdminDetailsButton');
  const closeAdminDetailsFooterButton = document.getElementById('closeAdminDetailsFooterButton');
  const adminOrderDetails = document.getElementById('adminOrderDetails');
  const cancelOrderModal = document.getElementById('cancelOrderModal');
  const closeCancelOrderButton = document.getElementById('closeCancelOrderButton');
  const keepOrderButton = document.getElementById('keepOrderButton');
  const confirmCancelOrderButton = document.getElementById('confirmCancelOrderButton');
  const cancelReasonInput = document.getElementById('cancelReasonInput');
  const cancelReasonError = document.getElementById('cancelReasonError');
  const deliveryConfirmModal = document.getElementById('deliveryConfirmModal');
  const confirmDeliveryButton = document.getElementById('confirmDeliveryButton');
  const cancelDeliveryButton = document.getElementById('cancelDeliveryButton');
  let pendingDeliveryOrderNumber = null;
  let adminRefreshTimer = null;
  let pendingCancellationOrderNumber = null;
  let activeAdminPage = 'orders';
  function openAdminMenu() {
    if (!isCommerceSession()) return;
    adminSidebar.inert = false;
    adminSidebar.classList.add('open');
    closeAdminButton.focus();
    adminMenuOverlay.classList.remove('hidden');
    adminMenuOverlay.setAttribute('aria-hidden', 'false');
    adminSidebar.setAttribute('aria-hidden', 'false');
    adminMenuButton.setAttribute('aria-expanded', 'true');
  }
  function closeAdminMenu() {
    if (adminSidebar.contains(document.activeElement)) adminMenuButton.focus();
    adminSidebar.inert = true;
    adminSidebar.classList.remove('open');
    adminMenuOverlay.classList.add('hidden');
    adminMenuOverlay.setAttribute('aria-hidden', 'true');
    adminSidebar.setAttribute('aria-hidden', 'true');
    adminMenuButton.setAttribute('aria-expanded', 'false');
  }
  function escapeAdminValue(value) {
  return String(value ?? '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}
  function formatOrderDate(dateValue) {
    const date = new Date(dateValue);
    if (Number.isNaN(date.getTime())) {
      return 'Data não informada';
    }
    return date.toLocaleString('pt-BR', {
      dateStyle: 'short',
      timeStyle: 'short'
    });
  }
  function getAdminOrders() {
    return getSavedOrders()
      .filter(order => (isMasterSession() && !isAdminPreview()) || String((order.commerceId || '1')) === String(getActiveCommerceId()))
      .map((order) => ({
        ...order,
        status: order.status || 'Novo',
        visualizado: order.visualizado === undefined ? true : Boolean(order.visualizado)
      }))
      .sort((firstOrder, secondOrder) => {
        const firstDate = new Date(firstOrder.data).getTime() || 0;
        const secondDate = new Date(secondOrder.data).getTime() || 0;
        return secondDate - firstDate;
      });
  }
  function setAdminPage(pageName) {
    if (!isCommerceSession()) return;
    if (pageName === 'exit') {
      logout();
      return;
    }
    const showProducts = pageName === 'products';
    activeAdminPage = adminPages[pageName] ? pageName : 'orders';
    const pageTitles = {
      profile: 'Meus dados',
      orders: 'Pedidos',
      products: 'Produtos',
      reports: 'Relatório',
      settings: 'Configurações'
    };
    adminPageTitle.textContent = pageTitles[activeAdminPage];
    if (activeAdminPage === 'reports') renderSalesReport();
    if (activeAdminPage === 'products') {
      resetProductEditor();
      renderProductControls();
    }
    Object.entries(adminPages).forEach(([name, page]) => {
      page.classList.toggle('hidden', name !== activeAdminPage);
    });
    adminNavigationButtons.forEach((button) => {
      const isActive = button.dataset.adminPage === activeAdminPage;
      button.classList.toggle('active', isActive);
      if (isActive) {
        button.setAttribute('aria-current', 'page');
      } else {
        button.removeAttribute('aria-current');
      }
    });
    closeAdminMenu();
    if (showProducts) document.getElementById('adminProductsPage').scrollIntoView({ block: 'start' });
  }
  function getOrderAgeLabel(dateValue) {
    const receivedAt = new Date(dateValue).getTime();
    const elapsedMinutes = Math.max(0, Math.floor((Date.now() - receivedAt) / 60000));
    if (!Number.isFinite(receivedAt)) {
      return 'tempo indisponível';
    }
    if (elapsedMinutes < 1) {
      return 'agora';
    }
    return `há ${elapsedMinutes} min`;
  }
  function isOrderLate(order) {
    if (['Entregue', 'Cancelado'].includes(order.status)) {
      return false;
    }
    const receivedAt = new Date(order.data).getTime();
    return Number.isFinite(receivedAt) && Date.now() - receivedAt >= 30 * 60000;
  }
  function renderStoreControls() {
    const store = getCurrentCommerceStore();
    if (!store) {
      adminStoreName.textContent = 'Comércio não encontrado';
      storeOpenToggle.checked = false;
      storeStatusMessage.textContent = 'Dados do comércio indisponíveis';
      storeStatusMessage.classList.add('closed');
      return;
    }
    const storeIsOpen = isStoreOpen(store.id);
    adminStoreName.textContent = store.name;
    storeOpenToggle.checked = storeIsOpen;
    storeStatusMessage.textContent = storeIsOpen
      ? 'Aberto para novos pedidos'
      : 'Pausado para novos pedidos';
    storeStatusMessage.classList.toggle('closed', !storeIsOpen);
  }
  function renderProductControls() {
    loadCommerceProducts();
    const store = getCurrentCommerceStore();
    if (!store) return;
    const totalProducts = store.products.length;
    const availableProducts = store.products.filter(product => isProductAvailable(store.id, product.name)).length;
    adminProductSummary.textContent = `${availableProducts} de ${totalProducts} produtos disponíveis`;
    const categoryFilter = document.getElementById('commerceProductCategoryFilter');
    const selected = categoryFilter.value;
    categoryFilter.innerHTML = '<option value="">Todas as categorias</option>' + [...new Set(store.products.map(product => product.category))].map(category => `<option value="${escapeAdminValue(category)}">${escapeAdminValue(category)}</option>`).join('');
    categoryFilter.value = selected;
    const search = document.getElementById('commerceProductSearch').value.trim().toLowerCase();
    adminProductAvailabilityList.innerHTML = `
      <div class="admin-product-store-group">
        <div class="admin-product-toggle-list" role="list">
          ${store.products.map((product, index) => {
            if ((categoryFilter.value && product.category !== categoryFilter.value) || !product.name.toLowerCase().includes(search)) return '';
            const productKey = getProductKey(store.id, product.name);
            const available = isProductAvailable(store.id, product.name);
            return `
              <label class="admin-product-toggle" role="listitem">
                <span class="admin-product-info"><strong>${escapeAdminValue(product.name)}</strong><small>${escapeAdminValue(product.category)} · ${formatCurrency(product.price)} · ${Number.isFinite(Number(product.preparationTime)) && Number(product.preparationTime) > 0 ? `${Number(product.preparationTime)} min` : '-'}</small></span>
                <span class="switch switch-small"><input type="checkbox" data-product-availability="${escapeAdminValue(productKey)}" data-store-id="${store.id}" data-product-name="${escapeAdminValue(product.name)}" ${available ? 'checked' : ''} aria-label="Disponibilidade de ${escapeAdminValue(product.name)}" /><span class="switch-slider"></span></span>
              </label><button type="button" class="admin-secondary-button" data-edit-product="${index}" data-edit-store="${store.id}">Editar ${escapeAdminValue(product.name)}</button><button type="button" class="admin-danger-button" data-delete-product="${index}">Excluir ${escapeAdminValue(product.name)}</button>
            `;
          }).join('') || '<p>Nenhum produto cadastrado.</p>'}
        </div>
      </div>
    `;
    adminProductAvailabilityList.querySelectorAll('[data-edit-product]').forEach(button => button.addEventListener('click', () => editCommerceProduct(button.dataset.editStore, Number(button.dataset.editProduct))));
    adminProductAvailabilityList.querySelectorAll('[data-delete-product]').forEach(button => button.addEventListener('click', () => { editCommerceProduct(store.id, Number(button.dataset.deleteProduct)); document.getElementById('cancelProductEdit').click(); }));
    adminProductAvailabilityList.querySelectorAll('[data-product-availability]').forEach((input) => {
      input.addEventListener('change', () => {
        try { saveProductAvailability(input.dataset.storeId, input.dataset.productName, input.checked); }
        catch { showStatus('Não foi possível salvar a disponibilidade.'); }
        renderProductControls();
      });
    });
  }
  function saveAdminOrders(orders) {
    if (!isCommerceSession()) throw new Error('Acesso exclusivo do comércio.');
    localStorage.setItem(ORDERS_STORAGE_KEY, JSON.stringify(orders));
  }
  function markOrderAsViewed(orderNumber) {
    if (!isCommerceSession()) return;
    const savedOrders = getSavedOrders();
    const order = savedOrders.find((savedOrder) => String(savedOrder.numero) === String(orderNumber) && ((isMasterSession() && !isAdminPreview()) || String((savedOrder.commerceId || '1')) === String(getActiveCommerceId())));
    if (!order || order.visualizado === true) {
      return;
    }
    order.visualizado = true;
    try { saveAdminOrders(savedOrders); } catch { showStatus('Não foi possível salvar o pedido.'); renderAdminOrders(); return; }
  }
  function openAdminOrderDetails(orderNumber) {
    if (!isCommerceSession()) return;
    markOrderAsViewed(orderNumber);
    renderAdminOrders();
    const order = getAdminOrders().find((savedOrder) => String(savedOrder.numero) === String(orderNumber));
    renderAdminOrderDetails(order);
  }
  function renderAdminOrderDetails(order) {
    if (!order) {
      adminDetailsModal.classList.add('hidden');
      adminDetailsModal.setAttribute('aria-hidden', 'true');
      adminOrderDetails.innerHTML = '';
      return;
    }
    const address = order.endereco || {};
    const payment = order.pagamento || {};
    const items = Array.isArray(order.itens) ? order.itens : [];
    adminOrderDetails.innerHTML = `
      <h3>Detalhes do pedido #${escapeAdminValue(order.numero)}</h3>
      <div class="admin-detail-section">
        <h4>Cliente</h4>
        <div class="admin-detail-row"><span class="admin-detail-label">Nome</span><strong class="admin-detail-value">${escapeAdminValue(order.cliente?.nome)}</strong></div>
        <div class="admin-detail-row"><span class="admin-detail-label">Telefone</span><strong class="admin-detail-value">${escapeAdminValue(order.cliente?.telefone)}</strong></div>
      </div>
      <div class="admin-detail-section">
        <h4>Entrega</h4>
        <div class="admin-detail-row"><span class="admin-detail-label">Endereço</span><strong class="admin-detail-value">${escapeAdminValue(address.rua)}</strong></div>
        <div class="admin-detail-row"><span class="admin-detail-label">Número</span><strong class="admin-detail-value">${escapeAdminValue(address.numero)}</strong></div>
        <div class="admin-detail-row"><span class="admin-detail-label">Bairro</span><strong class="admin-detail-value">${escapeAdminValue(address.bairro)}</strong></div>
        <div class="admin-detail-row"><span class="admin-detail-label">Complemento</span><strong class="admin-detail-value">${escapeAdminValue(address.complemento || 'Não informado')}</strong></div>
        <div class="admin-detail-row"><span class="admin-detail-label">Referência</span><strong class="admin-detail-value">${escapeAdminValue(address.referencia || 'Não informado')}</strong></div>
        <div class="admin-detail-row"><span class="admin-detail-label">Observação</span><strong class="admin-detail-value">${escapeAdminValue(order.observacao || 'Nenhuma')}</strong></div>
      </div>
      <div class="admin-detail-section">
        <h4>Produtos</h4>
        <div class="admin-detail-items">
          ${items.map((item) => `
            <div class="admin-detail-row">
              <span class="admin-detail-label">${escapeAdminValue(item.nome)} x${escapeAdminValue(item.quantidade)}<br>${formatCurrency(Number(item.preco) || 0)} cada</span>
              <strong class="admin-detail-value">${formatCurrency(Number(item.total) || 0)}</strong>
            </div>
          `).join('')}
        </div>
      </div>
      <div class="admin-detail-section">
        <h4>Valores e pagamento</h4>
        <div class="admin-detail-row"><span class="admin-detail-label">Subtotal</span><strong class="admin-detail-value">${formatCurrency(Number(order.subtotal) || 0)}</strong></div>
        <div class="admin-detail-row"><span class="admin-detail-label">Taxa de entrega</span><strong class="admin-detail-value">${formatCurrency(Number(order.taxaEntrega) || 0)}</strong></div>
        <div class="admin-detail-row"><span class="admin-detail-label">Total</span><strong class="admin-detail-value">${formatCurrency(Number(order.total) || 0)}</strong></div>
        <div class="admin-detail-row"><span class="admin-detail-label">Forma de pagamento</span><strong class="admin-detail-value">${escapeAdminValue(payment.forma)}</strong></div>
        <div class="admin-detail-row"><span class="admin-detail-label">Troco para</span><strong class="admin-detail-value">${payment.trocoPara === null || payment.trocoPara === undefined ? 'Não se aplica' : formatCurrency(Number(payment.trocoPara) || 0)}</strong></div>
        <div class="admin-detail-row"><span class="admin-detail-label">Troco</span><strong class="admin-detail-value">${payment.troco === null || payment.troco === undefined ? 'Não se aplica' : formatCurrency(Number(payment.troco) || 0)}</strong></div>
      </div>
      ${order.status === 'Cancelado' ? `
        <div class="admin-detail-section">
          <h4>Cancelamento</h4>
          <div class="admin-detail-row"><span class="admin-detail-label">Motivo do cancelamento</span><strong class="admin-detail-value">${escapeAdminValue(order.motivoCancelamento || 'Não informado')}</strong></div>
        </div>
      ` : ''}
    `;
    adminDetailsModal.classList.remove('hidden');
    adminDetailsModal.setAttribute('aria-hidden', 'false');
  }
  function closeAdminOrderDetails() {
    renderAdminOrderDetails(null);
  }
  function openCancelOrderConfirmation(orderNumber) {
    if (!isCommerceSession()) return;
    pendingCancellationOrderNumber = orderNumber;
    cancelReasonInput.value = '';
    cancelReasonError.textContent = '';
    cancelOrderModal.classList.remove('hidden');
    cancelOrderModal.setAttribute('aria-hidden', 'false');
    cancelReasonInput.focus();
    const ask = getCommerceSettings().confirmCancellation;
    document.getElementById('cancelOrderTitle').textContent = ask ? 'Cancelar pedido?' : 'Motivo do cancelamento';
    document.querySelector('.cancel-order-content > p').textContent = ask ? 'Tem certeza que deseja cancelar este pedido?' : 'Informe o motivo para registrar o cancelamento.';
    confirmCancelOrderButton.textContent = ask ? 'Sim, cancelar pedido' : 'Registrar cancelamento';
  }
  function closeCancelOrderConfirmation() {
    pendingCancellationOrderNumber = null;
    cancelReasonInput.value = '';
    cancelReasonError.textContent = '';
    cancelOrderModal.classList.add('hidden');
    cancelOrderModal.setAttribute('aria-hidden', 'true');
    renderAdminOrders();
  }
  function confirmOrderCancellation() {
    if (!isCommerceSession()) return;
    const reason = cancelReasonInput.value.trim();
    if (!reason) {
      cancelReasonError.textContent = 'Informe o motivo do cancelamento.';
      cancelReasonInput.focus();
      return;
    }
    const savedOrders = getSavedOrders();
    const order = savedOrders.find((savedOrder) => String(savedOrder.numero) === String(pendingCancellationOrderNumber) && ((isMasterSession() && !isAdminPreview()) || String((savedOrder.commerceId || '1')) === String(getActiveCommerceId())));
    if (!order) {
      closeCancelOrderConfirmation();
      return;
    }
    if (['Entregue', 'Cancelado'].includes(order.status)) {
      closeCancelOrderConfirmation();
      return;
    }
    order.status = 'Cancelado';
    order.motivoCancelamento = reason;
    try { saveAdminOrders(savedOrders); } catch { showStatus('Não foi possível salvar o pedido.'); renderAdminOrders(); return; }
    pendingCancellationOrderNumber = null;
    cancelOrderModal.classList.add('hidden');
    cancelOrderModal.setAttribute('aria-hidden', 'true');
    renderAdminOrders();
  }
  function updateAdminOrderStatus(orderNumber, status) {
    if (!isCommerceSession()) return;
    const savedOrders = getSavedOrders();
    const order = savedOrders.find((savedOrder) => String(savedOrder.numero) === String(orderNumber) && ((isMasterSession() && !isAdminPreview()) || String((savedOrder.commerceId || '1')) === String(getActiveCommerceId())));
    const allowedStatuses = {
      Novo: ['Em preparo', 'Cancelado'],
      'Em preparo': ['Saiu para entrega', 'Cancelado'],
      'Saiu para entrega': [],
      Entregue: [],
      Cancelado: []
    };
    const currentStatus = order ? (order.status || 'Novo') : '';
    if (!order || !allowedStatuses[currentStatus]?.includes(status)) {
      showStatus('Não foi possível atualizar o status do pedido. Atualize a lista e tente novamente.');
      return;
    }
    if (status === 'Cancelado') {
      openCancelOrderConfirmation(orderNumber);
      return;
    }
    order.status = status;
    delete order.motivoCancelamento;
    try { saveAdminOrders(savedOrders); } catch { showStatus('Não foi possível salvar o pedido.'); renderAdminOrders(); return; }
    if (status === 'Em preparo') {
      activeOrderFilter = 'active';
      document.querySelectorAll('[data-order-filter]').forEach(item => { item.classList.toggle('active', item.dataset.orderFilter === 'active'); item.setAttribute('aria-pressed', String(item.dataset.orderFilter === 'active')); });
    }
    renderAdminOrders();
  }
  function openDeliveryConfirmation(orderNumber) {
    if (!isCustomerView()) return;
    pendingDeliveryOrderNumber = orderNumber;
    deliveryConfirmModal.classList.remove('hidden');
    deliveryConfirmModal.setAttribute('aria-hidden', 'false');
    confirmDeliveryButton.focus();
  }
  function closeDeliveryConfirmation() {
    pendingDeliveryOrderNumber = null;
    deliveryConfirmModal.classList.add('hidden');
    deliveryConfirmModal.setAttribute('aria-hidden', 'true');
  }
  function confirmClientOrderDelivery(orderNumber) {
    if (!isCustomerView()) return;
    const savedOrders = getSavedOrders();
    const order = savedOrders.find(savedOrder => String(savedOrder.numero) === String(orderNumber) && isCurrentCustomerOrder(savedOrder));
    if (!order || order.status !== 'Saiu para entrega') return;
    order.status = 'Entregue';
    order.entregueConfirmadoEm = new Date().toISOString();
    localStorage.setItem(ORDERS_STORAGE_KEY, JSON.stringify(savedOrders));
    renderClientOrders();
    if (activeCustomerOrderNumber === orderNumber) renderSuccessDeliveryStatus(order);
    showStatus('Entrega confirmada. Obrigado!');
  }
  function renderAdminOrders(selectedOrderNumber = '') {
    if (!isCommerceSession()) return;
    const orders = getAdminOrders();
    const allPendingOrders = orders.filter((order) => !['Entregue', 'Cancelado'].includes(order.status));
    const allHistoryOrders = orders.filter((order) => ['Entregue', 'Cancelado'].includes(order.status));
    const pendingOrders = allPendingOrders.filter(order => activeOrderFilter === 'new' ? order.status === 'Novo' : ['Em preparo', 'Saiu para entrega'].includes(order.status));
    const historyOrders = allHistoryOrders;
    document.getElementById('adminActiveOrders').classList.toggle('hidden', activeOrderFilter === 'completed');
    document.getElementById('adminHistoryPage').classList.toggle('hidden', activeOrderFilter !== 'completed');
    document.querySelector('#adminActiveOrders h3').textContent = activeOrderFilter === 'new' ? 'Pedidos novos' : 'Pedidos ativos';
    const unreadOrders = orders.filter((order) => order.visualizado === false);
    adminPendingCount.textContent = allPendingOrders.length;
    adminUnreadCount.textContent = `${unreadOrders.length} ${unreadOrders.length === 1 ? 'novo' : 'novos'}`;
    adminHistoryCount.textContent = allHistoryOrders.length;
    adminPendingSectionCount.textContent = pendingOrders.length;
    adminHistorySectionCount.textContent = historyOrders.length;
    const renderGroup = (groupOrders, listElement, emptyMessage, canEditStatus) => {
      if (groupOrders.length === 0) {
        listElement.innerHTML = `<div class="admin-empty-state">${emptyMessage}</div>`;
        return;
      }
      listElement.innerHTML = groupOrders.map((order) => `
        <article class="admin-order-card ${isOrderLate(order) ? 'late' : ''}">
          <div class="admin-order-card-header">
            <strong class="admin-order-number">#${escapeAdminValue(order.numero)}</strong>
            <span class="admin-order-header-meta">
              ${order.visualizado === false ? '<span class="admin-new-badge">NOVO</span>' : ''}
              ${isOrderLate(order) ? '<span class="admin-late-badge">ATRASADO</span>' : ''}
              <span class="admin-order-age">${escapeAdminValue(getOrderAgeLabel(order.data))}</span>
              <span class="admin-order-date">${escapeAdminValue(formatOrderDate(order.data))}</span>
            </span>
          </div>
          <strong class="admin-order-customer">${escapeAdminValue(order.cliente?.nome || 'Cliente não informado')}</strong>
          <div class="admin-order-meta">
            <strong>${formatCurrency(Number(order.total) || 0)}</strong>
          </div>
          <div class="admin-order-meta">
            <span>${escapeAdminValue(order.pagamento?.forma || 'Pagamento não informado')}</span>
            <strong class="admin-order-status-label">${escapeAdminValue(order.status)}</strong>
          </div>
          ${canEditStatus && order.status === 'Novo' ? `<button class="admin-order-action-button" type="button" data-order-action="prepare" data-order-number="${escapeAdminValue(order.numero)}">Preparar</button>` : ''}
          ${canEditStatus && order.status === 'Em preparo' ? `<button class="admin-order-action-button" type="button" data-order-action="deliver" data-order-number="${escapeAdminValue(order.numero)}">Entregar pedido</button>` : ''}
          ${canEditStatus && ['Novo', 'Em preparo'].includes(order.status) ? `<button class="admin-danger-button" type="button" data-order-action="cancel" data-order-number="${escapeAdminValue(order.numero)}">Cancelar pedido</button>` : ''}
          <button class="admin-details-button" type="button" data-order-details="${escapeAdminValue(order.numero)}">Ver detalhes</button>
        </article>
      `).join('');
    };
    renderGroup(historyOrders, adminHistoryOrderList, 'Ainda não existem pedidos no histórico.', false);
    if (activeAdminPage === 'reports') renderSalesReport();
    if (selectedOrderNumber) {
      const selectedOrder = orders.find((order) => String(order.numero) === String(selectedOrderNumber));
      renderAdminOrderDetails(selectedOrder);
    }
  }
  function openAdminPanel() {
    if (!isCommerceSession()) return;
    loadCommerceProducts();
    setAdminPage('orders');
    closeAdminMenu();
    renderStoreControls();
    renderProductControls();
    renderAdminOrders();
    adminPanel.classList.remove('hidden');
    adminPanel.setAttribute('aria-hidden', 'false');
    adminMenuButton.setAttribute('aria-expanded', 'false');
    loadCommerceForms();
    configureAdminRefresh();
  }
  function closeAdminPanel() { closeAdminMenu(); }
  function closeClientOrders() {
    document.getElementById('clientOrdersPage').classList.add('hidden');
    if (clientOrdersTimer !== null) window.clearInterval(clientOrdersTimer);
    clientOrdersTimer = null;
  }
  function isCurrentCustomerOrder(order) {
    if (!currentUser) return false;
    if (order.customerId) return String(order.customerId) === String(currentUser.id);
    return normalizeEmail(order.customerEmail || 'cliente@teste.com') === normalizeEmail(currentUser.email);
  }
  function renderClientOrders() {
    if (!isCustomerView()) return;
    // Older orders belong to the single demo client supported by this project.
    const orders = getSavedOrders().filter(isCurrentCustomerOrder).slice().reverse();
    const list = document.getElementById('clientOrdersList');
    const markup = orders.map(order => `<article class="client-order-card">
      <div class="client-orders-header"><strong>Pedido #${escapeAdminValue(order.numero)}</strong><strong>${escapeAdminValue(order.status || 'Novo')}</strong></div>
      <p>${escapeAdminValue(formatOrderDate(order.data))}</p>
      <details><summary>Ver detalhes do pedido</summary>
        <ul>${(order.itens || []).map(item => `<li>${escapeAdminValue(item.quantidade)} × ${escapeAdminValue(item.nome)} — ${formatCurrency(Number(item.total) || 0)}</li>`).join('')}</ul>
        <p>Pagamento: ${escapeAdminValue(order.pagamento?.forma || 'Não informado')}</p>
        <p>Entrega: ${escapeAdminValue([order.endereco?.rua, order.endereco?.numero, order.endereco?.bairro].filter(Boolean).join(', '))}</p>
      </details>
      <p><strong>Total: ${formatCurrency(Number(order.total) || 0)}</strong></p>
      ${order.status === 'Saiu para entrega' ? `<button class="client-order-confirm-button" type="button" data-confirm-delivery="${escapeAdminValue(order.numero)}">Confirmar que recebi o pedido</button>` : ''}
      ${order.status === 'Cancelado' ? `<p>Motivo: ${escapeAdminValue(order.motivoCancelamento || 'Não informado')}</p>` : ''}
    </article>`).join('') || '<p>Você ainda não fez pedidos.</p>';
    if (list.dataset.markup !== markup) {
      const expanded = [...list.querySelectorAll('details')].map(detail => detail.open);
      list.innerHTML = markup;
      list.querySelectorAll('details').forEach((detail, index) => detail.open = expanded[index] || false);
      list.querySelectorAll('[data-confirm-delivery]').forEach(button => {
        button.addEventListener('click', () => openDeliveryConfirmation(button.dataset.confirmDelivery));
      });
      list.dataset.markup = markup;
    }
  }
  function openClientOrders() {
    if (!isCustomerView()) return;
    closeClientOrders();
    clientApp.classList.add('hidden');
    cartButton.classList.add('hidden');
    document.getElementById('clientOrdersPage').classList.remove('hidden');
    renderClientOrders();
    clientOrdersTimer = window.setInterval(renderClientOrders, 5000);
    document.getElementById('clientOrdersBackButton').focus();
  }
  document.getElementById('clientOrdersButton').addEventListener('click', openClientOrders);
  document.querySelectorAll('[data-google-login]').forEach(button => button.addEventListener('click', () => {
    continueWithGoogle(button.dataset.googleLogin, button.closest('form') === clientRegisterForm);
  }));
  const modeSwitcher = document.getElementById('modeSwitcher');
  const modeSwitcherButton = document.getElementById('modeSwitcherButton');
  modeSwitcherButton.addEventListener('click', () => {
    const expanded = modeSwitcherButton.getAttribute('aria-expanded') === 'true';
    modeSwitcherButton.setAttribute('aria-expanded', String(!expanded));
    modeSwitcher.classList.toggle('open', !expanded);
  });
  document.querySelectorAll('[data-mode-option]').forEach(button => button.addEventListener('click', async () => {
    const mode = button.dataset.modeOption;
    modeSwitcherButton.setAttribute('aria-expanded', 'false');
    modeSwitcher.classList.remove('open');
    if (mode === 'admin') {
      if (currentProfile === 'admin') returnToGeneralAdmin();
      return;
    }
    if (mode === 'client') {
      if (currentProfile === 'admin') await activateAdminPreview('customer');
      else switchMasterToClient();
      return;
    }
    if (mode === 'commerce') {
      if (currentProfile === 'admin') await activateAdminPreview('commerce');
      else switchMasterToCommerce();
    }
  }));
  document.getElementById('clientOrdersBackButton').addEventListener('click', showClientApp);
  document.getElementById('clientLogoutButton').addEventListener('click', () => logout());
  const clientProfileButton = document.getElementById('clientProfileButton');
  clientProfileButton.addEventListener('click', showClientLogin);
  document.getElementById('openClientRegisterButton').addEventListener('click', showClientRegister);
  const commerceProfileButton = document.getElementById('commerceProfileButton');
  commerceProfileButton.addEventListener('click', showCommerceLogin);
  document.querySelectorAll('[data-auth-back]').forEach(button => button.addEventListener('click', showProfileSelection));
  document.querySelectorAll('[data-use-another-account]').forEach(button => button.addEventListener('click', () => {
    const form = button.closest('form');
    useAnotherAccount(form.querySelector('input[type="email"]'), form.querySelector('input[type="password"]'), form);
  }));
  clientLoginForm.addEventListener('submit', event => { event.preventDefault(); loginClient(); });
  clientRegisterForm.addEventListener('submit', registerClient);
  commerceLoginForm.addEventListener('submit', event => { event.preventDefault(); loginCommerce(); });
  document.querySelectorAll('[data-forgot-password]').forEach(button => button.addEventListener('click', () => showForgotPassword(button.dataset.forgotPassword)));
  forgotPasswordForm.addEventListener('submit', async event => {
    event.preventDefault();
    const message = document.getElementById('forgotPasswordMessage');
    if (authRequestPending || !forgotPasswordForm.reportValidity()) return;
    if (!supabaseClient) { message.textContent = supabaseUnavailableMessage; return; }
    authRequestPending = true;
    message.textContent = 'Enviando...';
    try {
      const { error } = await supabaseClient.auth.resetPasswordForEmail(normalizeEmail(document.getElementById('forgotPasswordEmail').value), { redirectTo: `${location.origin}/` });
      message.textContent = error ? 'Não foi possível enviar o link. Confira o e-mail e tente novamente.' : 'Link enviado. Confira seu e-mail para renovar a senha.';
    } finally { authRequestPending = false; }
  });
  updatePasswordForm.addEventListener('submit', async event => {
    event.preventDefault();
    const message = document.getElementById('updatePasswordMessage');
    if (authRequestPending || !updatePasswordForm.reportValidity()) return;
    const password = document.getElementById('newPassword').value;
    if (password !== document.getElementById('newPasswordConfirm').value) { message.textContent = 'As senhas devem ser iguais.'; return; }
    if (!supabaseClient) { message.textContent = supabaseUnavailableMessage; return; }
    authRequestPending = true;
    message.textContent = 'Salvando...';
    try {
      const { error } = await supabaseClient.auth.updateUser({ password });
      if (error) { message.textContent = 'Não foi possível renovar a senha. Tente novamente.'; return; }
      message.textContent = 'Senha renovada. Você já pode entrar novamente.';
      updatePasswordForm.reset();
      await supabaseClient.auth.signOut();
      setTimeout(showProfileSelection, 800);
    } finally { authRequestPending = false; }
  });
  searchInput.addEventListener('input', renderStores);
  supportCarousel.addEventListener('click', event => {
    const card = event.target.closest('[data-carousel-card]');
    if (!card) return;
    event.preventDefault();
    const rect = card.getBoundingClientRect();
    const ratio = event.detail === 0 ? 0.5 : (event.clientX - rect.left) / rect.width;
    if (ratio < 0.25) moveSupportCarousel(-1);
    else if (ratio > 0.75) moveSupportCarousel(1);
    else if (card.dataset.cardAction === 'support') window.open(card.href, '_blank', 'noopener');
    else storeList.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
  closeMenuButton.addEventListener('click', closeStoreMenu);
  cartButton.addEventListener('click', openCart);
  closeCartButton.addEventListener('click', closeCart);
