  const SESSION_STORAGE_KEY = 'apiacasDeliverySession';
  const COMMERCES_KEY = 'apiacasCommerces';
  const PRODUCTS_KEY = 'apiacasProducts';
  function readStorage(key, fallback = []) {
    try {
      const value = JSON.parse(localStorage.getItem(key)) ?? fallback;
      return Array.isArray(fallback) && !Array.isArray(value) ? fallback : value;
    } catch { return fallback; }
  }
  function writeStorage(key, value) { localStorage.setItem(key, JSON.stringify(value)); }
  function createId(prefix) { return `${prefix}-${window.crypto?.randomUUID ? window.crypto.randomUUID() : Date.now() + '-' + Math.random().toString(16).slice(2)}`; }
  function normalizeEmail(value) { return String(value || '').trim().toLowerCase(); }
  function onlyNumbers(value) { return String(value || '').replace(/\D/g, ''); }
  function isValidCpf(value) {
    const digits = onlyNumbers(value);
    if (digits.length !== 11 || /^([0-9])\1{10}$/.test(digits)) return false;
    let sum = 0;
    for (let index = 0; index < 9; index += 1) sum += Number(digits[index]) * (10 - index);
    let check = (sum * 10) % 11; if (check === 10) check = 0;
    if (check !== Number(digits[9])) return false;
    sum = 0;
    for (let index = 0; index < 10; index += 1) sum += Number(digits[index]) * (11 - index);
    check = (sum * 10) % 11; if (check === 10) check = 0;
    return check === Number(digits[10]);
  }
  function isValidCnpj(value) {
    const digits = onlyNumbers(value);
    if (digits.length !== 14 || /^([0-9])\1{13}$/.test(digits)) return false;
    const calculate = length => {
    let sum = 0; let weight = length === 12 ? 5 : 6;
      for (let index = 0; index < length; index += 1) {
        sum += Number(digits[index]) * weight;
        weight -= 1; if (weight === 1) weight = 9;
      }
      const remainder = sum % 11;
      return remainder < 2 ? 0 : 11 - remainder;
    };
    return calculate(12) === Number(digits[12]) && calculate(13) === Number(digits[13]);
  }
  function parseMoneyValue(value) {
    const text = String(value || '').trim().replace(/\s/g, '');
    if (!text) return NaN;
    const normalized = text.includes(',')
      ? text.replace(/\./g, '').replace(',', '.')
      : text;
    return Number(normalized);
  }
  function normalizeBusinessTime(value) {
    const text = String(value || '').trim();
    const match = text.match(/^(\d{1,2})(?::(\d{1,2}))?$/);
    if (!match) return '';
    const hours = Number(match[1]);
    const minutes = match[2] === undefined ? 0 : Number(match[2]);
    if (hours > 23 || minutes > 59) return '';
    return `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}`;
  }
  function getCurrentSession() { return readCommerceStorage(SESSION_STORAGE_KEY, null); }
  function cacheCommerce(commerce) {
    const cached = {
      id: String(commerce.id), owner_id: commerce.owner_id, name: commerce.name,
      owner: commerce.responsible_name, document: commerce.document, phone: commerce.phone,
      email: commerce.email, category: commerce.category,
      address: { street: commerce.street, number: commerce.number, neighborhood: commerce.neighborhood, complement: commerce.complement },
      businessHours: { opening: commerce.opening_time, closing: commerce.closing_time },
      hours: [commerce.opening_time, commerce.closing_time].filter(Boolean).join(' - '),
      isOpen: commerce.is_open, status: commerce.status, delivery: commerce.delivery_fee
    };
    const commerces = readStorage(COMMERCES_KEY, []);
    writeStorage(COMMERCES_KEY, [...commerces.filter(item => String(item.id) !== cached.id), cached]);
    return cached;
  }
  function getLoggedCommerce() {
    return readStorage(COMMERCES_KEY, []).find(commerce => String(commerce.id) === String(getActiveCommerceId())) || null;
  }
  function getCurrentCommerceStore() { return stores.find(store => String(store.id) === String(getActiveCommerceId())) || null; }
  async function updateLoggedCommerce(changes) {
    if (!isCommerceSession() || (isMasterSession() && !isAdminPreview())) throw new Error('Selecione um comércio para alterar os dados.');
    const commerces = readStorage(COMMERCES_KEY, []);
    const index = commerces.findIndex(commerce => String(commerce.id) === String(currentCommerceId));
    if (index < 0) throw new Error('Comércio não encontrado.');
    const { data: { session }, error: sessionError } = await supabaseClient.auth.getSession();
    if (isAdminPreview()) return false;
    if (sessionError || !session?.user || session.user.id !== currentUser?.id || String(commerces[index].owner_id) !== String(session.user.id)) throw new Error('Entre novamente na conta do comércio.');
    const values = {};
    if (changes.phone !== undefined) values.phone = onlyNumbers(changes.phone);
    if (changes.email !== undefined) values.email = normalizeEmail(changes.email);
    if (changes.isOpen !== undefined) values.is_open = Boolean(changes.isOpen);
    if (changes.hours !== undefined) {
      const parts = changes.hours.split(/\s*[-–]\s*/);
      const opening = normalizeBusinessTime(parts[0]?.replace(/^(\d{2}:\d{2}):00$/, '$1'));
      const closing = normalizeBusinessTime(parts[1]?.replace(/^(\d{2}:\d{2}):00$/, '$1'));
      if (parts.length !== 2 || !opening || !closing) throw new Error('Informe o horário como 18:00 - 23:00.');
      values.opening_time = opening;
      values.closing_time = closing;
    }
    const { data, error } = await supabaseClient.from('commerces').update(values).eq('owner_id', currentUser.id).select('*').single();
    if (error) { console.error('Falha ao atualizar comércio:', error.code); throw new Error('Não foi possível salvar os dados do comércio. Tente novamente.'); }
    cacheCommerce(data);
    loadCommerceProducts();
    return true;
  }
  const PENDING_COMMERCE_KEY = 'apiacasPendingCommerceRegistration';
  const pendingCommerceFields = ['name', 'responsible_name', 'responsible_cpf', 'company_cnpj', 'phone', 'email', 'category', 'street', 'number', 'neighborhood', 'complement', 'opening_time', 'closing_time'];
  function savePendingCommerceRegistration(values) {
    writeStorage(PENDING_COMMERCE_KEY, Object.fromEntries(pendingCommerceFields.map(key => [key, String(values[key] || '')])));
  }
  function getPendingCommerceRegistration() {
    return readStorage(PENDING_COMMERCE_KEY, null);
  }
  function clearPendingCommerceRegistration() {
    localStorage.removeItem(PENDING_COMMERCE_KEY);
  }
  async function fetchCommerceByOwnerId(userId) {
    const { data, error } = await supabaseClient.from('commerces').select('*').eq('owner_id', userId).maybeSingle();
    if (error) throw error;
    return data;
  }
  async function completePendingCommerceRegistration(user) {
    const { data: { session }, error } = await supabaseClient.auth.getSession();
    if (error || !session?.user || session.user.id !== user?.id) throw new Error('Sessão indisponível.');
    const owner = session.user;
    const pending = getPendingCommerceRegistration();
    const compatible = pending && (normalizeEmail(pending.email) === normalizeEmail(owner.email)
      || (getOAuthSignup() && getOAuthRole() === 'commerce'));
    let commerce = await fetchCommerceByOwnerId(owner.id);
    if (!commerce && compatible) {
      const values = Object.fromEntries(pendingCommerceFields.map(key => [key, String(pending[key] || '')]));
      const result = await supabaseClient.from('commerces').insert({ ...values, document: values.company_cnpj, owner_id: owner.id, is_open: false, status: 'pendente_aprovacao', registration_status: 'nao_consultada', delivery_fee: 0 }).select('*').single();
      if (result.error) {
        // Another tab may have completed the same registration.
        if (result.error.code === '23505') commerce = await fetchCommerceByOwnerId(owner.id);
        if (!commerce) throw result.error;
      } else commerce = result.data;
    }
    if (commerce) {
      cacheCommerce(commerce);
      if (compatible) clearPendingCommerceRegistration();
    }
    return commerce;
  }
  function persistCommerceProducts(commerceId, updated) {
    if (!isCommerceSession() || (!isMasterSession() && String(commerceId) !== String(currentCommerceId))) throw new Error('Acesso negado.');
    const products = readStorage(PRODUCTS_KEY, []);
    const own = products.filter(product => String(product.commerceId) === String(commerceId));
    if (updated.some(product => product.id && !own.some(item => String(item.id) === String(product.id)))) throw new Error('Produto não encontrado.');
    const saved = updated.map(product => ({ ...product, id: product.id || createId('product'), commerceId, available: product.available !== false, updatedAt: new Date().toISOString() }));
    writeStorage(PRODUCTS_KEY, [...products.filter(product => String(product.commerceId) !== String(commerceId)), ...saved]);
    loadCommerceProducts();
  }
  async function registerCommerce(event) {
    event.preventDefault();
    if (!supabaseClient) { document.getElementById('commerceRegisterError').textContent = supabaseUnavailableMessage; return; }
    if (authRequestPending) return;
    const form = document.getElementById('commerceRegisterForm');
    const error = document.getElementById('commerceRegisterError');
    const value = name => document.getElementById('registerCommerce' + name).value.trim();
    const password = document.getElementById('registerCommercePassword').value;
    const email = normalizeEmail(value('Email'));
    if (!form.reportValidity()) return;
    if (password.length < 6 || password !== document.getElementById('registerCommercePasswordConfirm').value) { error.textContent = 'As senhas devem ser iguais e ter pelo menos 6 caracteres.'; return; }
    const responsibleCpf = value('ResponsibleCpf');
    const companyCnpj = value('CompanyCnpj');
    if (['Name','Owner','Category','Street','Number','Neighborhood'].some(name => !value(name)) || onlyNumbers(value('Phone')).length < 10) { error.textContent = 'Preencha os dados e telefone corretamente.'; return; }
    if (!isValidCpf(responsibleCpf)) { error.textContent = 'CPF do responsável inválido.'; return; }
    if (!isValidCnpj(companyCnpj)) { error.textContent = 'CNPJ da empresa inválido.'; return; }
    const opening = normalizeBusinessTime(value('Opening'));
    const closing = normalizeBusinessTime(value('Closing'));
    if (!opening || !closing) { error.textContent = 'Informe os horários no formato 24 horas, como 18 ou 18:00.'; return; }
    authRequestPending = true;
    const pending = {
      name: value('Name'), responsible_name: value('Owner'), responsible_cpf: onlyNumbers(responsibleCpf), company_cnpj: onlyNumbers(companyCnpj),
      phone: onlyNumbers(value('Phone')), email, category: value('Category'), street: value('Street'), number: value('Number'),
      neighborhood: value('Neighborhood'), complement: value('Complement'), opening_time: opening, closing_time: closing,
    };
    if (form.dataset.submitting === 'true') return;
    form.dataset.submitting = 'true';
    error.textContent = 'Criando cadastro...';
    try {
      savePendingCommerceRegistration(pending);
      const { data, error: signUpError } = await supabaseClient.auth.signUp({ email, password });
      if (signUpError) {
        console.error('Falha no cadastro Auth:', signUpError.code);
        error.textContent = 'Não foi possível criar a conta. Se já possui uma conta, entre para concluir o cadastro do comércio.';
        return;
      }
      if (!data.user) { error.textContent = 'Não foi possível iniciar o cadastro. Tente novamente.'; return; }
      document.getElementById('registerCommercePassword').value = '';
      document.getElementById('registerCommercePasswordConfirm').value = '';
      if (!data.session) {
        error.textContent = 'Confira o e-mail de confirmação enviado. Depois de confirmar, entre no app para concluir o cadastro do comércio neste navegador.';
        return;
      }
      currentUser = data.session.user;
      const commerce = await completePendingCommerceRegistration(currentUser);
      if (!commerce) throw new Error('Cadastro pendente indisponível.');
      currentCommerceId = String(commerce.id);
      form.reset(); error.textContent = 'Cadastro enviado para análise administrativa.';
      showCommerceLogin();
      showStatus('Cadastro enviado para análise administrativa.');
    } catch (failure) {
      console.error('Falha ao concluir cadastro do comércio:', failure.code || failure.name);
      error.textContent = failure.code === '23505' ? 'Este CNPJ já está cadastrado.' : 'Não foi possível concluir o cadastro. Seus dados pendentes serão usados ao entrar novamente.';
    } finally { delete form.dataset.submitting; authRequestPending = false; }
  }
  const categories = ['Todos', 'Brasileira', 'Pizzas', 'Lanches', 'Saudável', 'Japonesa', 'Doces'];
