    const store = getCurrentCommerceStore();
    const product = store?.products[editingProduct.index];
    if (!product || String(product.id) !== String(editingProduct.id)) { formMessage(productEditor, 'Produto não encontrado. Abra a edição novamente.', true); return; }
    if (!window.confirm(`Excluir o produto "${product.name}"?`)) return;
    const updated = store.products.filter((item, index) => index !== editingProduct.index);
    try {
      persistCommerceProducts(store.id, updated);
      store.products = updated;
      resetProductEditor();
      renderProductControls();
      renderStores();
    } catch { formMessage(productEditor, 'Não foi possível excluir o produto. Tente novamente.', true); }
  });
  productEditor.addEventListener('submit', async event => {
    event.preventDefault();
    if (!isCommerceSession()) return;
    const store = getCurrentCommerceStore();
    if (!store || (editingProduct && (String(editingProduct.storeId) !== String(store.id) || String(store.products[editingProduct.index]?.id) !== String(editingProduct.id)))) { formMessage(productEditor, 'Abra a edição do produto novamente.', true); return; }
    const preparationTimeText = productEditor.elements.preparationTime.value.trim();
    const product = { type: productEditor.elements.type.value, category: productEditor.elements.category.value.trim(), preparationTime: preparationTimeText === '' ? null : Number(preparationTimeText), available: editingProduct ? store?.products[editingProduct.index]?.available !== false : true, name: productEditor.elements.name.value.trim(), description: productEditor.elements.description.value.trim(), price: parseMoneyValue(productEditor.elements.price.value), image: editingProduct ? store?.products[editingProduct.index]?.image || '' : '' };
    if (!store || !product.name || !product.category || !product.description || !Number.isFinite(product.price) || product.price <= 0 || (product.preparationTime !== null && (!Number.isInteger(product.preparationTime) || product.preparationTime < 0))) { formMessage(productEditor, 'Preencha nome, categoria, valor e descrição. O tempo de preparo é opcional.', true); return; }
    const index = editingProduct?.index ?? -1;
    if (store.products.some((item, i) => i !== index && item.name.toLowerCase() === product.name.toLowerCase())) { formMessage(productEditor, 'Já existe um produto com esse nome neste comércio.', true); return; }
    const file = productEditor.elements.imageFile.files[0];
    if (!editingProduct && !file) { formMessage(productEditor, 'A imagem do produto é obrigatória.', true); return; }
    if (file && (!['image/jpeg', 'image/png', 'image/webp'].includes(file.type) || file.size > 2 * 1024 * 1024)) {
