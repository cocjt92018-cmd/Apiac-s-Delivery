const SUPABASE_URL = 'https://mbgwkfzzkksfpzbjttwu.supabase.co';
const SUPABASE_KEY = 'sb_publishable_O9qQeAbT9DxbQz8Id2PwJg_pz3Ln0gY';

let supabaseClient = null;

let supabaseUnavailableMessage =
  'O Supabase ainda precisa ser configurado com a URL e a chave pública do projeto.';

if (
  SUPABASE_URL &&
  SUPABASE_KEY &&
  !SUPABASE_URL.startsWith('COLE_') &&
  !SUPABASE_KEY.startsWith('COLE_')
) {
  try {
    const url = new URL(SUPABASE_URL);

    if (!['https:', 'http:'].includes(url.protocol)) {
      throw new Error('Protocolo inválido na URL do Supabase.');
    }

    if (!window.supabase?.createClient) {
      throw new Error('Biblioteca Supabase não carregada.');
    }

    supabaseClient = window.supabase.createClient(
      SUPABASE_URL,
      SUPABASE_KEY
    );
  } catch (error) {
    console.error('Falha ao inicializar Supabase:', error);

    supabaseUnavailableMessage =
      'Não foi possível iniciar o Supabase. Confira a configuração e sua conexão e recarregue a página.';
  }
}

